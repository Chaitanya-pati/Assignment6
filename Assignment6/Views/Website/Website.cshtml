@model HomeMasterViewModel

@{
    ViewData["Title"] = "Website";
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vernekar's Radha Heritage Home Stay</title>
     <link rel="icon" type="image/png" href="~/images/HomeIc.png">
    <!-- CDN Links -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
   <link href="~/css/website-responsive.css" rel="stylesheet" />
</head>
<body>

<!-- ============================================
     HEADER & NAVIGATION
     ============================================ -->
<header class="header">
    <div class="nav-container">
        <!-- Logo with Font Awesome Icon -->
        <a href="#home" class="logo">
            <i class="fas fa-home logo-icon"></i>
            <span>Vernekar's Radha Heritage Home Stay</span>
        </a>

        <!-- Desktop & Mobile Navigation -->
        <ul class="nav-menu" id="navMenu">
            <li class="nav-item">
                <a href="#rooms" class="nav-link">Rooms</a>
            </li>
            <li class="nav-item">
                <a href="#awards" class="nav-link">Awards</a>
            </li>
            <li class="nav-item">
                <a href="#features" class="nav-link">Features</a>
            </li>
            <li class="nav-item">
                <a href="#calendar" class="nav-link">Calendar</a>
            </li>
            <li class="nav-item">
                <a href="#contact" class="nav-link">Contact</a>
            </li>
            <li class="nav-item" hidden>
                <a asp-action="Login" asp-controller="Login" class="nav-link admin-link" title="Admin Login">
                    <i class="fas fa-user"></i>
                </a>
            </li>
        </ul>

        <!-- Hamburger Button -->
        <button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobileOverlay"></div>
</header>

<!-- ============================================
     HERO SECTION - PROFESSIONAL WITHOUT IMAGE
     ============================================ -->
<section class="hero" id="home">
    <div class="hero-content">
        <h1>A Heritage Stay That Feels Like Home</h1>
        <p>Enjoy comfort and a warm welcome in every stay !!</p>
    </div>
</section>

<!-- ============================================
     CALENDAR SECTION
     ============================================ -->
<section id="calendar">
    <div class="calendar-container">
        <div class="calendar-header">
            <h3 class="calendar-title">
                <i class="fas fa-calendar-week me-2"></i>Booking Calendar
            </h3>
            <p class="text-muted mb-0">Reserve Your Stay</p>
        </div>
        <div id="websiteCalendar"></div>

        <!-- REPLACEMENT (use this): -->
        <div class="calendar-legend">
            <div class="legend-item">
                <div class="legend-color available"></div>
                <span>Available</span>
            </div>
            <div class="legend-item">
                <div class="legend-color classic-ground"></div>
                <span>Radha Classic (Ground Floor)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color heritage-first"></div>
                <span>Radha Heritage (First Floor)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color both-floors"></div>
                <span>Both Properties Booked</span>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     BOOKING FORM
     ============================================ -->
<div class="booking-form">
    <div class="form-row">
        <div class="form-group">
            <label for="property">Select Property</label>
            <select id="property" name="property">
                <option value="">Select a Property</option>
                @foreach (var home in Model.Homes)
                {
                    <option value="@home.Id">@home.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="checkin">Check-in Date</label>
            <input type="date" id="checkin" name="checkin">
        </div>
        <div class="form-group">
            <label for="checkout">Check-out Date</label>
            <input type="date" id="checkout" name="checkout">
        </div>
        <div class="form-group">
            <button class="search-btn" onclick="searchAvailability()">
                <i class="fas fa-search me-2"></i>Search Availability
            </button>
        </div>
    </div>
</div>

<!-- ============================================
     ROOMS SECTION
     ============================================ -->
<section class="section" id="rooms" style="padding:10px;">
    <h2 class="text-center" style="font-size: 2rem;margin-bottom: 2.5rem;color: #333;font-weight: 700;">Our Beautiful Rooms</h2>
    <p class="section-subtitle">Experience Comfort & Luxury</p>

    <!-- Common Sitting Area -->
    <div class="common-area-grid">
        <div class="category-card common-area-card" data-carousel="common-sitting">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="~/images/radha_classic/siitingarea1.webp" alt="Sitting Area 1" loading="eager" />
                    <img src="~/images/radha_classic/siitingarea2.webp" alt="Sitting Area 2" loading="lazy" />
                    <img src="~/images/radha_classic/siitingarea3.webp" alt="Sitting Area 3" loading="lazy" />
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Common Sitting Area</h3>
                <p class="card-description">Relax and unwind in our beautifully designed outdoor sitting areas.</p>
            </div>
        </div>
    </div>

    <!-- Radha Classic -->
    <h2 class="floor-title">
        <i class="fas fa-building floor-icon"></i>
        Radha Classic - Ground Floor
    </h2>
    <div class="category-grid">
        <!-- Bedrooms Card -->
        <div class="category-card" data-carousel="classic-bedrooms">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Classic/BedRoom1.webp" alt="Bedroom 1" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom2.webp" alt="Bedroom 2" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom3.webp" alt="Bedroom 3" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom4.webp" alt="Bedroom 4" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom5.webp" alt="Bedroom 5" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom6.webp" alt="Bedroom 6" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom7.webp" alt="Bedroom 7" loading="lazy">
                    <img src="Images/Radha_Classic/BedRoom8.webp" alt="Bedroom 8" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Bedrooms</h3>
                <p class="card-description">Spacious bedrooms with modern amenities for a restful stay.</p>
            </div>
        </div>

        <!-- Halls Card -->
        <div class="category-card" data-carousel="classic-halls">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Classic/Hall1.webp" alt="Hall 1" loading="lazy">
                    <img src="Images/Radha_Classic/Hall2.webp" alt="Hall 2" loading="lazy">
                    <img src="Images/Radha_Classic/Hall3.webp" alt="Hall 3" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Living Halls</h3>
                <p class="card-description">Comfortable living spaces perfect for family gatherings.</p>
            </div>
        </div>

        <!-- Kitchen Area Card -->
        <div class="category-card" data-carousel="classic-kitchen">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Classic/KitchenArea1.webp" alt="Kitchen 1" loading="lazy">
                    <img src="Images/Radha_Classic/KitchenArea2.webp" alt="Kitchen 2" loading="lazy">
                    <img src="Images/Radha_Classic/KitchenArea3.webp" alt="Kitchen 3" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Kitchen Areas</h3>
                <p class="card-description">Fully equipped modern kitchens for your convenience.</p>
            </div>
        </div>

        <!-- Toilets Card -->
        <div class="category-card" data-carousel="classic-toilets">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Classic/Toilet1.webp" alt="Toilet 1" loading="lazy">
                    <img src="Images/Radha_Classic/Toilet2.webp" alt="Toilet 2" loading="lazy">
                    <img src="Images/Radha_Classic/Toilet3.webp" alt="Toilet 3" loading="lazy">
                    <img src="Images/Radha_Classic/Toilet4.webp" alt="Toilet 4" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Bathrooms</h3>
                <p class="card-description">Clean modern bathroom facilities with premium fixtures.</p>
            </div>
        </div>
    </div>

    <!-- Radha Heritage -->
    <h2 class="floor-title">
        <i class="fas fa-city floor-icon"></i>
        Radha Heritage - First Floor
    </h2>
    <div class="category-grid">
        <!-- Bedrooms Card -->
        <div class="category-card" data-carousel="heritage-bedrooms">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Heritage/BedRoom1.webp" alt="Bedroom 1" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom2.webp" alt="Bedroom 2" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom3.webp" alt="Bedroom 3" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom4.webp" alt="Bedroom 4" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom5.webp" alt="Bedroom 5" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom6.webp" alt="Bedroom 6" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom7.webp" alt="Bedroom 7" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom8.webp" alt="Bedroom 8" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom9.webp" alt="Bedroom 9" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom10.webp" alt="Bedroom 10" loading="lazy">
                    <img src="Images/Radha_Heritage/BedRoom11.webp" alt="Bedroom 11" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Bedrooms</h3>
                <p class="card-description">Heritage-style bedrooms with traditional charm and modern comfort.</p>
            </div>
        </div>

        <!-- Halls Card -->
        <div class="category-card" data-carousel="heritage-halls">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Heritage/Hall1.webp" alt="Hall 1" loading="lazy">
                    <img src="Images/Radha_Heritage/Hall2.webp" alt="Hall 2" loading="lazy">
                    <img src="Images/Radha_Heritage/Hall3.webp" alt="Hall 3" loading="lazy">
                    <img src="Images/Radha_Heritage/Hall4.webp" alt="Hall 4" loading="lazy">
                    <img src="Images/Radha_Heritage/Hall5.webp" alt="Hall 5" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Living Halls</h3>
                <p class="card-description">Elegant living spaces with heritage architecture.</p>
            </div>
        </div>

        <!-- Dining Area Card -->
        <div class="category-card" data-carousel="heritage-dining">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Heritage/Dinning1.webp" alt="Dining 1" loading="lazy">
                    <img src="Images/Radha_Heritage/Dinning2.webp" alt="Dining 2" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Dining Areas</h3>
                <p class="card-description">Spacious dining areas perfect for family meals.</p>
            </div>
        </div>

        <!-- Toilets Card -->
        <div class="category-card" data-carousel="heritage-toilets">
            <div class="carousel-container">
                <div class="carousel-images">
                    <img src="Images/Radha_Heritage/Toilet1.webp" alt="Toilet 1" loading="lazy">
                    <img src="Images/Radha_Heritage/Toilet2.webp" alt="Toilet 2" loading="lazy">
                    <img src="Images/Radha_Heritage/Toilet3.webp" alt="Toilet 3" loading="lazy">
                    <img src="Images/Radha_Heritage/Toilet4.webp" alt="Toilet 4" loading="lazy">
                </div>
            </div>
            <div class="card-content">
                <h3 class="card-title">Bathrooms</h3>
                <p class="card-description">Well-maintained bathrooms with modern amenities.</p>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     AWARDS SECTION
     ============================================ -->
<section id="awards" class="section awards-section">
    <div class="awards-header">
        <div class="award-badge">
            <i class="fas fa-trophy trophy-icon"></i>
            <h2 class="awards-title">BRAND OF INDIA 2025</h2>
            <i class="fas fa-trophy trophy-icon"></i>
        </div>
        <div class="award-subtitle">
            <i class="fas fa-star star-icon"></i>
            <span>Excellence in Indian Hospitality</span>
            <i class="fas fa-star star-icon"></i>
        </div>
    </div>

    <div class="awards-content">
        <div class="row align-items-center">
            <!-- Award Images Carousel -->
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="awards-carousel-container">
                    <div class="awards-carousel-images">
                        <img src="~/Images/Awards/award1.jpg" alt="Brand of India Award 2025" class="award-image" loading="lazy">
                        <img src="~/Images/Awards/award2.jpg" alt="Excellence Award" class="award-image" loading="lazy">
                        <img src="~/Images/Awards/award3.jpg" alt="Hospitality Recognition" class="award-image" loading="lazy">
                        <img src="~/Images/Awards/award4.jpg" alt="Heritage Homestay Award" class="award-image" loading="lazy">
                    </div>
                    <div class="carousel-controls">
                        <button class="carousel-btn prev-btn" onclick="moveAwardSlide(-1)" aria-label="Previous award">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button class="carousel-btn next-btn" onclick="moveAwardSlide(1)" aria-label="Next award">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="carousel-indicators" id="awardIndicators"></div>
                </div>
            </div>

            <!-- Award Description -->
            <div class="col-lg-6">
                <div class="award-description">
                    <h3 class="award-property-name">Vernekar's<br>Radha Classic Heritage Homestay<br>Belagavi, Karnataka</h3>

                    <div class="award-message">
                        <p class="lead">We are proud to share that <strong>Radha Classic Heritage</strong> has been honoured as the <strong>Best Homestay – 2025</strong>!</p>

                        <div class="recognition-list">
                            <p class="mb-3">This recognition celebrates our commitment to:</p>
                            <ul class="award-features">
                                <li>
                                    <i class="fas fa-star feature-icon"></i>
                                    <span>Exceptional Hospitality</span>
                                </li>
                                <li>
                                    <i class="fas fa-star feature-icon"></i>
                                    <span>Impeccable Customer Service</span>
                                </li>
                                <li>
                                    <i class="fas fa-star feature-icon"></i>
                                    <span>Luxurious Ambience with Heritage Touch</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     FEATURES SECTION
     ============================================ -->
<section id="features" class="section features">
    <h2>Why Choose Vernekar's Radha Heritage Home Stay?</h2>
    <div class="features-grid">
        <div class="feature-card">
            <i class="fas fa-home feature-icon"></i>
            <h3>Authentic Experience</h3>
            <p>Live like a local with our carefully selected homestay properties</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-map-marked-alt feature-icon"></i>
            <h3>Local Guidance</h3>
            <p>Get insider tips and recommendations from knowledgeable hosts</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-dollar-sign feature-icon"></i>
            <h3>Great Value</h3>
            <p>Affordable rates with excellent amenities and personal service</p>
        </div>
    </div>
</section>

 <!-- Booking Modal -->
    <div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="bookingModalLabel">
                        <i class="fas fa-calendar-plus"></i> Book Your Stay
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="bookingForm">
                    <!-- Customer Information Section -->
                    <!-- Replace the existing Customer Information Section in your bookingModal with this enhanced version -->
                    <!-- Customer Information Section -->
                    <div class="form-section mb-4">
                        <h6 class="section-title">
                            <i class="fas fa-user"></i> Customer Information
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="CustomerName" class="form-label">Full Name *</label>
                                <input type="text" class="form-control" id="CustomerName" name="CustomerName"
                                       placeholder="Enter full name" required>
                                <div id="CustomerName-feedback" class="invalid-feedback" style="display: none;"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="CustomerEmail" class="form-label">Email Address *</label>
                                <input type="email" class="form-control" id="CustomerEmail" name="CustomerEmail"
                                       placeholder="Enter email address" required>
                                <div id="CustomerEmail-feedback" class="invalid-feedback" style="display: none;"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="CustomerPhone" class="form-label">Phone Number *</label>
                                <input type="tel" class="form-control" id="CustomerPhone" name="CustomerPhone"
                                       placeholder="Enter phone number" required>
                                <div id="CustomerPhone-feedback" class="invalid-feedback" style="display: none;"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="GuestNumbers" class="form-label">Total Guests *</label>
                                <input type="number" class="form-control" id="GuestNumbers" name="GuestNumbers"
                                       placeholder="Enter total number of guests" min="1" max="50" required>
                                <div id="GuestNumbers-feedback" class="invalid-feedback" style="display: none;"></div>
                            </div>
                        </div>
                        <!-- Guest Breakdown -->
                        <div class="row">
                            <div class="col-6 col-md-3 mb-3">
                                <label for="wb_TotalAdults" class="form-label"><i class="fas fa-male"></i> Adults</label>
                                <input type="number" class="form-control" id="wb_TotalAdults" placeholder="0" min="0" max="50">
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <label for="wb_TotalKids" class="form-label"><i class="fas fa-child"></i> Kids (Below 10)</label>
                                <input type="number" class="form-control" id="wb_TotalKids" placeholder="0" min="0" max="20">
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <label for="wb_MaleCount" class="form-label"><i class="fas fa-mars"></i> Male</label>
                                <input type="number" class="form-control" id="wb_MaleCount" placeholder="0" min="0" max="50">
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <label for="wb_FemaleCount" class="form-label"><i class="fas fa-venus"></i> Female</label>
                                <input type="number" class="form-control" id="wb_FemaleCount" placeholder="0" min="0" max="50">
                            </div>
                        </div>
                        <small class="text-muted d-block mb-3">Male/Female count includes both adults and children.</small>
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label for="Document" class="form-label">
                                    <i class="fas fa-file-upload"></i> Upload Identity Document *
                                </label>
                                <div class="file-upload-wrapper">
                                    <input type="file" class="file-upload-input" id="Document" name="Document"
                                           accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" onchange="handleFileUpload(this)" required>
                                    <label for="Document" class="file-upload-label" id="documentLabel">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <span class="file-info">Click to upload document (PDF, JPG, PNG, DOC)</span>
                                    </label>
                                </div>
                                <div id="Document-feedback" class="invalid-feedback" style="display: none;"></div>
                                <small class="form-text text-muted">Please upload a valid government ID or passport</small>
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Booking Details Section -->
                    <div class="form-section mb-4">
                        <h6 class="section-title">
                            <i class="fas fa-home"></i> Booking Details
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="BookingDateFrom" class="form-label">Check-in Date *</label>
                                <input type="date" class="form-control" id="BookingDateFrom" name="BookingDateFrom">
                                <div id="BookingDateFrom-feedback" class="invalid-feedback" style="display: none;"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="BookingDateTo" class="form-label">Check-out Date *</label>
                                <input type="date" class="form-control" id="BookingDateTo" name="BookingDateTo">
                                <div id="BookingDateTo-feedback" class="invalid-feedback" style="display: none;"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label for="SelectedProperty" class="form-label">Selected Property</label>
                                <input type="text" class="form-control" id="SelectedProperty" name="SelectedProperty" readonly>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Room Selection</label>
                                <div class="room-selection-container">
                                    <button type="button" class="btn btn-outline-primary btn-sm room-selection-btn"
                                            onclick="openRoomSelection()" id="selectRoomsBtn">
                                        <i class="fas fa-map"></i> Choose Rooms
                                        <span id="roomSelectionBadge" class="room-badge d-none">0</span>
                                    </button>
                                    <div class="mt-2">
                                        <small class="text-muted">Or book entire property</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Room Selection Summary -->
                        <div id="roomSelectionSummary" class="mt-3 d-none">
                            <div class="alert alert-info">
                                <h6><i class="fas fa-info-circle"></i> Selected Rooms:</h6>
                                <div id="selectedRoomsDisplay"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Business Details (Optional) -->
                    <div class="form-section mb-4">
                        <h6 class="section-title">
                            <i class="fas fa-building"></i> Business Details <small class="text-muted ms-2" style="font-size:0.8rem;font-weight:400;">(Optional – for GST invoice)</small>
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="wb_BusinessName" class="form-label">Business Name</label>
                                <input type="text" class="form-control" id="wb_BusinessName" placeholder="Enter business name">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="wb_GstNumber" class="form-label">GST Number</label>
