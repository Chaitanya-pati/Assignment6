    function validateForm() {
        let isValid = true;
        
        const validations = [
            validateCustomerName(),
            validateEmail(),
            validatePhone(),
            validateGuestNumbers(),
            validateDateRange(),
            validateFileUpload(),
            validateMessage()
        ];
        
        isValid = validations.every(validation => validation === true);
        
        if (!isValid) {
            const firstInvalidField = document.querySelector('.is-invalid');
            if (firstInvalidField) {
                firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstInvalidField.focus();
            }
        }
        
        return isValid;
    }

    // Initialize validation event listeners
    function initializeWebsiteValidation() {
        // Customer Name validation
        document.getElementById('CustomerName').addEventListener('blur', validateCustomerName);
        document.getElementById('CustomerName').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                validateCustomerName();
            } else {
                clearValidationMessage('CustomerName');
            }
        });

        // Email validation
        document.getElementById('CustomerEmail').addEventListener('blur', validateEmail);
        document.getElementById('CustomerEmail').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                validateEmail();
            } else {
                clearValidationMessage('CustomerEmail');
            }
        });

        // Phone validation
        document.getElementById('CustomerPhone').addEventListener('blur', validatePhone);
        document.getElementById('CustomerPhone').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                validatePhone();
            } else {
                clearValidationMessage('CustomerPhone');
            }
        });

        // Guest numbers validation
        document.getElementById('GuestNumbers').addEventListener('blur', validateGuestNumbers);
        document.getElementById('GuestNumbers').addEventListener('input', validateGuestNumbers);

        // Date validation
        document.getElementById('BookingDateFrom').addEventListener('change', validateDateRange);
        document.getElementById('BookingDateTo').addEventListener('change', validateDateRange);

        // File upload validation
        document.getElementById('Document').addEventListener('change', function() {
            handleFileUpload(this);
            validateFileUpload();
        });

        // Message validation with character counter
        document.getElementById('Message').addEventListener('input', validateMessage);
        document.getElementById('Message').addEventListener('blur', validateMessage);

        // Initialize character counter
        validateMessage();
    }

    function saveBookingData() {
        if (!validateForm()) {
            showNotification('Please correct the validation errors before submitting.', 'error');
            return;
        }

        const selectedRooms = JSON.parse(localStorage.getItem('selectedRoomData') || '[]');
        const submitBtn = document.getElementById('saveBookingBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        $.ajax({
            url: '/Scheduler/SaveBooking',
            type: 'POST',
            data: {
                'BookingData.CustomerName': document.getElementById('CustomerName').value.trim(),
                'BookingData.CustomerEmail': document.getElementById('CustomerEmail').value.trim(),
                'BookingData.CustomerPhone': document.getElementById('CustomerPhone').value.trim(),
                'BookingData.Message': document.getElementById('Message').value.trim(),
                'BookingData.BookingDateFrom': document.getElementById('BookingDateFrom').value,
                'BookingData.BookingDateTo': document.getElementById('BookingDateTo').value,
                'BookingData.HomeId': document.getElementById('HomeId').value,
                'BookingData.PaymentStatus': "pending",
                'BookingData.CreatedAt': new Date().toISOString(),
                'BookingData.Price': document.getElementById('TotalPrice').value,
                'BookingData.GuestNumbers': document.getElementById('GuestNumbers').value,
                'BookingData.Document': document.getElementById('Document').files[0] ? document.getElementById('Document').files[0].name : null,
                'BookingData.IsBooked': false,
                'BookingData.CheckOut': false,
                'BookingData.TotalDays': document.getElementById('TotalDays').value,
                'Rooms': JSON.stringify(selectedRooms)
            },
            success: function (response) {
                if (response.success) {
                    showNotification('Booking saved! Redirecting to payment...', 'success');
                    $('#bookingModal').modal('hide');

                    // Redirect to payment page after 1.5 seconds
                    setTimeout(function () {
                        window.location.href = `/Payment/InitiatePayment?bookingId=${response.bookingId}`;
                    }, 1500);
                } else {
                    showNotification(response.message || 'Failed to save booking.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            },
            error: function (xhr, status, error) {
                console.error('Booking submission error:', error);
                let errorMessage = 'Error saving booking. Please try again.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                }
                showNotification(errorMessage, 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    }
    function resetForm() {
        document.getElementById('bookingForm').reset();
        
        // Clear all validation states and feedback messages
        document.querySelectorAll('.form-control, .form-select').forEach(field => {
            field.classList.remove('is-invalid');
        });
        
        document.querySelectorAll('.invalid-feedback').forEach(feedback => {
            feedback.style.display = 'none';
        });

        // Reset file upload label
        const label = document.getElementById('documentLabel');
        const fileInfo = label.querySelector('.file-info');
        if (label && fileInfo) {
            label.classList.remove('has-file');
            fileInfo.innerHTML = 'Click to upload document (PDF, JPG, PNG, DOC)';
        }

        // Clear room selection
        localStorage.removeItem('selectedRoomData');
        selectedRooms = [];
        updateRoomSelectionDisplay([], false);

        // Reset character counter
        validateMessage();
    }

    // Room Selection Functions
    function openRoomSelection() {
        const homeId = document.getElementById('HomeId').value;
        if (!homeId) {
            showNotification('Please select a property first', 'error');
            return;
        }
        
        // Load rooms for the selected property
        loadRoomsForProperty(homeId);
        
        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('roomSelectionModal'));
        modal.show();
    }

    function loadRoomsForProperty(homeId) {
        const container = document.getElementById('roomListContainer');
        container.innerHTML = `
            <div class="text-center p-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2">Loading rooms...</div>
            </div>
        `;
        
        // Get rooms from the model data
        const rooms = window.websiteData.rooms.filter(r => r.homeId == homeId);
        
        // Small delay for UX
        setTimeout(() => displayRooms(rooms), 500);
    }

    function displayRooms(rooms) {
        const container = document.getElementById('roomListContainer');

        let html = `
            <div class="row">
                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="bookingType" id="entireProperty" value="entire" checked>
                        <label class="form-check-label fw-bold" for="entireProperty">
                            <i class="fas fa-home text-primary"></i> Book Entire Property
                        </label>
                        <div class="text-muted small ms-4">Get access to all rooms and facilities - Can book anytime</div>
                    </div>
                </div>
        `;

        // Only show individual room selection if rooms are available
        if (rooms.length > 0) {
            html += `
                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="bookingType" id="selectiveRooms" value="selective">
                        <label class="form-check-label fw-bold" for="selectiveRooms">
                            <i class="fas fa-list text-success"></i> Select Individual Rooms
                        </label>
                        <div class="text-muted small ms-4">
                            Choose specific bedrooms only - Must book within 3 days of stay
                            <div class="alert alert-warning mt-2 p-2">
                                <small><i class="fas fa-info-circle"></i> Individual room booking is only available 3 days before your check-in date</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="roomCheckboxes" class="mt-3" style="display: none;">
                <div class="row">
            `;

            rooms.forEach(room => {
                const isChargeable = room.price > 0;
                const roomPrice = room.price || 0;

                // Determine if room is selectable (only bedrooms)
                const roomType = room.label;
                const isBedroom = roomType.includes('bedroom') || roomType.includes('bed') ||
                    roomType.includes('suite') || roomType.includes('room');
                const isSelectableRoom = isBedroom &&
                    !roomType.includes('hall') &&
                    !roomType.includes('balcony') &&
                    !roomType.includes('living') &&
                    !roomType.includes('kitchen');

                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card room-card ${isChargeable ? 'border-primary' : 'border-secondary'} ${!isSelectableRoom ? 'opacity-50' : ''}">
                            <div class="card-body">
                                <div class="form-check">
                                    <input class="form-check-input room-checkbox" type="checkbox"
                                           id="room_${room.id}" value="${room.id}"
                                           data-name="${room.label}" data-price="${roomPrice}"
                                           ${!isSelectableRoom ? 'disabled' : ''}>
                                    <label class="form-check-label" for="room_${room.id}">
                                        <strong>${room.label}</strong>
                                        ${isChargeable ?
                            `<span class="badge bg-primary ms-2">${formatPrice(roomPrice)}/night</span>` :
                            '<span class="badge bg-secondary ms-2">Free</span>'
                        }
                                        ${!isSelectableRoom ?
                            '<span class="badge bg-warning ms-2">Not Selectable</span>' :
                            ''
                        }
                                    </label>
                                    ${!isSelectableRoom ?
                            '<div class="text-muted small">Only bedrooms can be selected individually</div>' :
                            ''
                        }
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += `
                </div>
            </div>
            `;
        } else {
            html += `
            </div>
            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle"></i>
                <strong>Room details not configured.</strong><br>
                You can book the entire property which includes all available accommodations.
            </div>
            `;
        }

        container.innerHTML = html;

        // Add event listeners
        document.querySelectorAll('input[name="bookingType"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const roomCheckboxes = document.getElementById('roomCheckboxes');
                if (roomCheckboxes) {
                    if (this.value === 'selective') {
                        // Check if dates are within 3-day restriction for individual rooms
                        if (!validateIndividualRoomBookingDates()) {
                            // Reset to entire property if dates don't meet requirement
                            document.getElementById('entireProperty').checked = true;
                            roomCheckboxes.style.display = 'none';
                            return;
                        }
                        roomCheckboxes.style.display = 'block';
                    } else {
                        roomCheckboxes.style.display = 'none';
                        // Clear all room selections
                        document.querySelectorAll('.room-checkbox').forEach(cb => cb.checked = false);
                    }
                }
            });
        });
    }

    function confirmRoomSelection() {
        const bookingType = document.querySelector('input[name="bookingType"]:checked').value;

        if (bookingType === 'entire') {
            // Entire property booking - no date restrictions
            selectedRooms = [];
            localStorage.setItem('selectedRoomData', JSON.stringify([]));
            updateRoomSelectionDisplay([], true);
        } else {
            // Individual room booking - validate 3-day rule
            if (!validateIndividualRoomBookingDates()) {
                showNotification('Individual room booking requires check-in within 3 days. Switching to entire property booking.', 'warning');
                document.getElementById('entireProperty').checked = true;
                selectedRooms = [];
                localStorage.setItem('selectedRoomData', JSON.stringify([]));
                updateRoomSelectionDisplay([], true);
            } else {
                // Selective room booking - only get enabled checkboxes
                const checkedRooms = document.querySelectorAll('.room-checkbox:checked:not([disabled])');

                if (checkedRooms.length === 0) {
                    showNotification('Please select at least one bedroom or switch to entire property booking.', 'warning');
                    return;
                }

                selectedRooms = Array.from(checkedRooms).map(cb => {
                    const roomId = parseInt(cb.value);
                    const roomData = window.websiteData.rooms.find(r => r.id === roomId);

                    return {
                        Id: roomId,
                        Label: roomData ? roomData.label : cb.dataset.name,
                        Price: roomData ? (roomData.price || 0) : parseFloat(cb.dataset.price || 0),
                        HomeId: roomData ? roomData.homeId : null
                    };
                });
                localStorage.setItem('selectedRoomData', JSON.stringify(selectedRooms));
                updateRoomSelectionDisplay(selectedRooms, false);
            }
        }

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('roomSelectionModal'));
        modal.hide();

        // Update pricing with corrected calculation
        const propertyId = document.getElementById('HomeId').value;
        const checkin = document.getElementById('BookingDateFrom').value;
        const checkout = document.getElementById('BookingDateTo').value;
        const homeName = getHomeName(propertyId);

        if (checkin && checkout && propertyId) {
            const checkInDate = new Date(checkin);
            const checkOutDate = new Date(checkout);
            const timeDiff = checkOutDate.getTime() - checkInDate.getTime();
            const totalDays = Math.ceil(timeDiff / (1000 * 3600 * 24));
            
            // Get property base price
            const propertyPricePerDay = getPriceForProperty(propertyId);
            
            let finalPrice;
            if (selectedRooms.length > 0) {
                // Individual room pricing
                const roomTotal = selectedRooms.reduce((sum, room) => sum + (room.Price || 0), 0);
                finalPrice = roomTotal * totalDays;
            } else {
                // Entire property pricing
                finalPrice = propertyPricePerDay * totalDays;
            }

            updateBookingSummary(homeName, checkin, checkout, totalDays, propertyPricePerDay, finalPrice);

            document.getElementById('SelectedRoomIds').value = selectedRooms.map(room => room.Id).join(',');
            document.getElementById('SelectedRoomData').value = JSON.stringify(selectedRooms);
        }
    }

    function updateRoomSelectionDisplay(rooms, isEntireProperty) {
        const badge = document.getElementById('roomSelectionBadge');
        const summary = document.getElementById('roomSelectionSummary');
        const display = document.getElementById('selectedRoomsDisplay');
        
        if (isEntireProperty) {
            badge.textContent = 'Full';
            badge.className = 'room-badge bg-success';
            badge.classList.remove('d-none');
            
            display.innerHTML = '<strong>Entire Property Selected</strong><br><small class="text-muted">Access to all rooms and facilities</small>';
            summary.classList.remove('d-none');
        } else if (rooms.length > 0) {
            badge.textContent = rooms.length;
            badge.className = 'room-badge bg-warning';
            badge.classList.remove('d-none');
            
            const roomNames = rooms.map(r => r.Label).join(', ');
            display.innerHTML = `<strong>Selected Rooms:</strong><br>${roomNames}`;
            summary.classList.remove('d-none');
        } else {
            badge.classList.add('d-none');
            summary.classList.add('d-none');
        }
    }

    // Smooth scrolling for navigation links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });


    function validateBookingDates() {
        const checkinInput = document.getElementById('checkin');
        const checkoutInput = document.getElementById('checkout');

        if (!checkinInput.value || !checkoutInput.value) {
            return false;
        }

        const checkinDate = new Date(checkinInput.value);
        const checkoutDate = new Date(checkoutInput.value);
        const today = new Date();

        // Reset times for accurate comparison
        today.setHours(0, 0, 0, 0);
        checkinDate.setHours(0, 0, 0, 0);
        checkoutDate.setHours(0, 0, 0, 0);

        // Check if dates are valid
        if (checkinDate < today) {
            showNotification('Check-in date cannot be in the past.', 'error');
            return false;
        }

        if (checkoutDate <= checkinDate) {
            showNotification('Check-out date must be after check-in date.', 'error');
            return false;
        }

        return true;
    }

  
    document.addEventListener('DOMContentLoaded', function () {
        // Use consistent element IDs - assuming the correct ones are 'BookingDateFrom' and 'BookingDateTo'
        const checkinInput = document.getElementById('BookingDateFrom');
        const checkoutInput = document.getElementById('BookingDateTo');

        if (checkinInput) {
            checkinInput.addEventListener('change', function () {
                // Update minimum checkout date
                const checkinDate = this.value;
                if (checkoutInput) {
                    checkoutInput.setAttribute('min', checkinDate);
                }
                // If individual rooms are selected, validate the booking rules
                const selectiveRadio = document.getElementById('selectiveRooms');
                if (selectiveRadio && selectiveRadio.checked) {
                    if (!validateIndividualRoomBookingDates()) {
                        // Switch back to entire property
                        document.getElementById('entireProperty').checked = true;
                        const roomCheckboxes = document.getElementById('roomCheckboxes');
                        if (roomCheckboxes) {
                            roomCheckboxes.style.display = 'none';
                        }
                    }
                }
            });
        }

        if (checkoutInput) {
            checkoutInput.addEventListener('change', function () {
                // If individual rooms are selected, validate the booking rules
                const selectiveRadio = document.getElementById('selectiveRooms');
                if (selectiveRadio && selectiveRadio.checked) {
                    if (!validateIndividualRoomBookingDates()) {
                        // Switch back to entire property
                        document.getElementById('entireProperty').checked = true;
                        const roomCheckboxes = document.getElementById('roomCheckboxes');
                        if (roomCheckboxes) {
                            roomCheckboxes.style.display = 'none';
                        }
                    }
                }
            });
        }
    });

    function validateIndividualRoomBookingDates() {
        const checkinInput = document.getElementById('BookingDateFrom');
        const checkoutInput = document.getElementById('BookingDateTo');

        if (!checkinInput.value || !checkoutInput.value) {
            showNotification('Please select check-in and check-out dates first before choosing individual rooms.', 'error');
            return false;
        }

        const checkinDate = new Date(checkinInput.value);
        const today = new Date();
        today.setHours(0, 0, 0, 0); // Reset time to start of day
        checkinDate.setHours(0, 0, 0, 0);

        // Calculate the difference in days
        const timeDiff = checkinDate.getTime() - today.getTime();
        const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24));

        // Check if booking is for today (same day)
        if (daysDiff === 0) {
            showNotification("You can't book individual rooms for today. Please select 'Book Entire Property' or choose a future date.", 'error', 6000);
            return false;
        }

        // Check if booking is for past dates
        if (daysDiff < 0) {
            showNotification('Cannot book for past dates.', 'error');
            return false;
        }

        // Check if booking is more than 3 days in advance
        if (daysDiff > 3) {
            const maxBookingDate = new Date(checkinDate);
            maxBookingDate.setDate(maxBookingDate.getDate() - 3);
            showNotification(
                `Individual room booking for ${checkinDate.toDateString()} is only available from ${maxBookingDate.toDateString()} onwards. For earlier booking, please select "Book Entire Property".`,
                'error',
                8000
            );
            return false;
        }

        return true;
    }

      const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    const navOverlay = document.getElementById('navOverlay');

    function toggleMenu() {
        hamburger.classList.toggle('active');
        navLinks.classList.toggle('active');
        navOverlay.classList.toggle('active');

        // Prevent body scroll when menu is open
        if (navLinks.classList.contains('active')) {
            document.body.style.overflow = 'hidden';
        } else {
            document.body.style.overflow = '';
        }
    }

    function closeMenu() {
        hamburger.classList.remove('active');
        navLinks.classList.remove('active');
        navOverlay.classList.remove('active');
        document.body.style.overflow = '';
    }

    // Event listeners
    hamburger.addEventListener('click', toggleMenu);
    navOverlay.addEventListener('click', closeMenu);

    // Close menu when clicking on navigation links
    navLinks.addEventListener('click', (e) => {
        if (e.target.tagName === 'A') {
            closeMenu();
        }
    });

    // Close menu on window resize if screen becomes large
    window.addEventListener('resize', () => {
        if (window.innerWidth > 768) {
            closeMenu();
        }
    });

    // Handle escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && navLinks.classList.contains('active')) {
            closeMenu();
        }
        });

    // Auto-sliding carousel functionality
    class Carousel {
        constructor(element) {
            this.card = element;
            this.container = element.querySelector('.carousel-images');
            this.images = element.querySelectorAll('.carousel-images img');
            this.currentIndex = 0;
            this.interval = null;
            this.isHovered = false;

            this.init();
        }

        init() {
            // Start auto-sliding
            this.startAutoSlide();

            // Pause on hover
            this.card.addEventListener('mouseenter', () => {
                this.isHovered = true;
                this.stopAutoSlide();
            });

            // Resume on mouse leave
            this.card.addEventListener('mouseleave', () => {
                this.isHovered = false;
                this.startAutoSlide();
            });
        }

        slide() {
            this.currentIndex = (this.currentIndex + 1) % this.images.length;
            const offset = -this.currentIndex * 100;
            this.container.style.transform = `translateX(${offset}%)`;
        }

        startAutoSlide() {
            if (this.interval) return;
            // Slide every 2.5 seconds
            this.interval = setInterval(() => this.slide(), 2500);
        }

        stopAutoSlide() {
            if (this.interval) {
                clearInterval(this.interval);
                this.interval = null;
            }
        }
    }

    // Initialize all carousels
    document.addEventListener('DOMContentLoaded', () => {
        const carouselCards = document.querySelectorAll('.category-card');
        carouselCards.forEach(card => new Carousel(card));
    });

</script>
