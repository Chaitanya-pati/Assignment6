                } else {
                    indicator.classList.remove('reviews_active');
                }
            });
        }

        function reviewsNextSlide() {
            reviewsCurrentSlide = (reviewsCurrentSlide + 1) % reviewsTotalSlides;
            reviewsUpdateCarousel();
        }

        function reviewsPrevSlide() {
            reviewsCurrentSlide = (reviewsCurrentSlide - 1 + reviewsTotalSlides) % reviewsTotalSlides;
            reviewsUpdateCarousel();
        }

        function reviewsGoToSlide(index) {
            reviewsCurrentSlide = index;
            reviewsUpdateCarousel();
        }

        // Auto-play
        let reviewsAutoPlayInterval = setInterval(reviewsNextSlide, 5000);

        // Pause auto-play on hover
        const reviewsCarouselContainer = document.querySelector('.reviews_carousel_container');
        reviewsCarouselContainer.addEventListener('mouseenter', () => {
            clearInterval(reviewsAutoPlayInterval);
        });

        reviewsCarouselContainer.addEventListener('mouseleave', () => {
            reviewsAutoPlayInterval = setInterval(reviewsNextSlide, 5000);
        });

        // Initialize
        reviewsUpdateCarousel();

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
