    function saveBookingData(paymentType) {
        if (!validateForm()) {
            showNotification('Please correct the validation errors before submitting.', 'error');
            return;
        }

        const isPayLater = (paymentType === 'payLater');
        const selectedRooms = JSON.parse(localStorage.getItem('selectedRoomData') || '[]');

        const payLaterBtn = document.getElementById('payLaterBtn');
        const onlineBtn = document.getElementById('saveBookingBtn');
        const activeBtn = isPayLater ? payLaterBtn : onlineBtn;
        const originalText = activeBtn.innerHTML;
        payLaterBtn.disabled = true;
        onlineBtn.disabled = true;
        activeBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Please wait...';

        const purposeVal = document.getElementById('wb_PurposeOfVisit').value;
        const purposeOther = document.getElementById('wb_PurposeOfVisitOther').value.trim();

        const bookingPayload = {
            'BookingData.CustomerName': document.getElementById('CustomerName').value.trim(),
            'BookingData.CustomerEmail': document.getElementById('CustomerEmail').value.trim(),
            'BookingData.CustomerPhone': document.getElementById('CustomerPhone').value.trim(),
            'BookingData.Message': document.getElementById('Message').value.trim(),
            'BookingData.BookingDateFrom': document.getElementById('BookingDateFrom').value,
            'BookingData.BookingDateTo': document.getElementById('BookingDateTo').value,
            'BookingData.HomeId': document.getElementById('HomeId').value,
            'BookingData.PaymentStatus': isPayLater ? 'Pay Later' : 'pending',
            'BookingData.CreatedAt': new Date().toISOString(),
            'BookingData.Price': document.getElementById('TotalPrice').value,
            'BookingData.GuestNumbers': document.getElementById('GuestNumbers').value,
            'BookingData.TotalAdults': document.getElementById('wb_TotalAdults').value || null,
            'BookingData.TotalKids': document.getElementById('wb_TotalKids').value || null,
            'BookingData.MaleCount': document.getElementById('wb_MaleCount').value || null,
            'BookingData.FemaleCount': document.getElementById('wb_FemaleCount').value || null,
            'BookingData.BusinessName': document.getElementById('wb_BusinessName').value.trim() || null,
            'BookingData.GstNumber': document.getElementById('wb_GstNumber').value.trim() || null,
            'BookingData.PurposeOfVisit': purposeVal || null,
            'BookingData.PurposeOfVisitOther': purposeOther || null,
            'BookingData.PaymentMethod': isPayLater ? 'Pay Later' : 'Online',
            'BookingData.IsBooked': false,
            'BookingData.CheckOut': false,
            'BookingData.TotalDays': document.getElementById('TotalDays').value,
            'Rooms': selectedRooms
        };

        const targetUrl = isPayLater ? '/Website/PayLaterBooking' : '/Scheduler/SaveBooking';

        $.ajax({
            url: targetUrl,
            type: 'POST',
            data: bookingPayload,
            success: function (response) {
                if (response.success) {
                    if (isPayLater) {
                        showNotification(response.message || 'Booking request submitted! We will contact you to confirm.', 'success');
                        $('#bookingModal').modal('hide');
                        setTimeout(function () {
                            location.reload();
                        }, 3000);
                    } else {
                        showNotification('Booking saved! Redirecting to payment...', 'success');
                        $('#bookingModal').modal('hide');
                        setTimeout(function () {
                            window.location.href = `/Payment/InitiatePayment?bookingId=${response.bookingId}`;
                        }, 1500);
                    }
                } else {
                    showNotification(response.message || 'Failed to save booking.', 'error');
                    payLaterBtn.disabled = false;
                    onlineBtn.disabled = false;
                    activeBtn.innerHTML = originalText;
                }
            },
            error: function (xhr, status, error) {
                console.error('Booking submission error:', error);
                let errorMessage = 'Error saving booking. Please try again.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                }
                showNotification(errorMessage, 'error');
                payLaterBtn.disabled = false;
                onlineBtn.disabled = false;
                activeBtn.innerHTML = originalText;
            }
        });
    }
