     function addBookingStatus(dayElement, date) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        date.setHours(0, 0, 0, 0);
 
        const isPastDate = date < today;
 
        // Remove all existing status classes
        dayElement.classList.remove(
            'booked', 'available', 'past-date',
            'booked-classic', 'booked-heritage', 'booked-both'
        );
 
        // Remove any existing booking-info badge
        const existingInfo = dayElement.querySelector('.booking-info');
        if (existingInfo) existingInfo.remove();
 
        // ── Past dates ──────────────────────────────────────────
        if (isPastDate) {
            dayElement.classList.add('past-date');
            dayElement.title = 'Past date';
            return;
        }
 
        // ── No data loaded yet ──────────────────────────────────
        if (!window.bookingCalendarData) {
            dayElement.classList.add('available');
            dayElement.title = 'Available for booking';
            return;
        }
 
        const dateKey = date.toISOString().split('T')[0];
        const dayBookings = window.bookingCalendarData[dateKey];
 
        // ── No bookings on this day ─────────────────────────────
        if (!dayBookings || dayBookings.length === 0) {
            dayElement.classList.add('available');
            dayElement.title = 'Available for booking';
            return;
        }
 
        // ── Determine which floor(s) are booked ─────────────────
        // "Classic"  → ground floor (grey)
        // "Heritage" → first floor  (orange)
        debugger
        const hasClassic  = dayBookings.some(b => b.homeName && b.homeName.includes('Ground Floor'));
        const hasHeritage = dayBookings.some(b => b.homeName && b.homeName.includes('1st Floor'));
 
        // Build tooltip
        const propertyNames = [...new Set(dayBookings.map(b => b.homeName))];
        dayElement.title = `Booked:\n${propertyNames.join('\n')}`;
 
        if (hasClassic && hasHeritage) {
            // Both floors booked → split diagonal
            dayElement.classList.add('booked-both');
 
            const badge = document.createElement('div');
            badge.className = 'booking-info';
            badge.style.cssText = `
                position: absolute;
                top: 2px;
                left: 2px;
                background: rgba(255,255,255,0.88);
                color: #333;
                font-size: 9px;
                padding: 1px 4px;
                border-radius: 3px;
                font-weight: 700;
                z-index: 5;
                white-space: nowrap;
            `;
            badge.textContent = 'Both';
            dayElement.style.position = 'relative';
            dayElement.appendChild(badge);
 
        } else if (hasClassic) {
            // Ground floor only → grey
            dayElement.classList.add('booked-classic');
 
            const badge = document.createElement('div');
            badge.className = 'booking-info';
            badge.style.cssText = `
                position: absolute;
                bottom: 2px;
                left: 2px;
                right: 2px;
                background: rgba(45,55,72,0.82);
                color: #fff;
                font-size: 9px;
                padding: 1px 3px;
                border-radius: 2px;
                font-weight: 600;
                text-align: center;
                z-index: 5;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            `;
            badge.textContent = 'Classic';
            dayElement.style.position = 'relative';
            dayElement.appendChild(badge);
 
        } else if (hasHeritage) {
            // First floor only → orange
            dayElement.classList.add('booked-heritage');
 
            const badge = document.createElement('div');
            badge.className = 'booking-info';
            badge.style.cssText = `
                position: absolute;
                bottom: 2px;
                left: 2px;
                right: 2px;
                background: rgba(120,60,0,0.75);
                color: #fff;
                font-size: 9px;
                padding: 1px 3px;
                border-radius: 2px;
                font-weight: 600;
                text-align: center;
                z-index: 5;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            `;
            badge.textContent = 'Heritage';
            dayElement.style.position = 'relative';
            dayElement.appendChild(badge);
 
        } else {
            // Fallback for any other property names — use grey
            dayElement.classList.add('booked-classic');
            dayElement.title = `Booked: ${propertyNames.join(', ')}`;
        }
    }


