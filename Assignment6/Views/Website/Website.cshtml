        });

        reviewsCarouselContainer.addEventListener('touchend', (e) => {
            reviewsTouchEndX = e.changedTouches[0].screenX;
            reviewsHandleSwipe();
        });

        function reviewsHandleSwipe() {
            if (reviewsTouchEndX < reviewsTouchStartX - 50) reviewsNextSlide();
