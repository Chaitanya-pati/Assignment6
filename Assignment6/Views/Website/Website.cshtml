                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveBookingBtn" onclick="saveBookingData()">
                        <i class="fas fa-save"></i> Book Now
                    </button>
