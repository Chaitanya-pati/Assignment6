    function searchAvailability() {
        const propertyId = document.getElementById('property').value;
        const checkin = document.getElementById('checkin').value;
        const checkout = document.getElementById('checkout').value;

        if (!propertyId || !checkin || !checkout) {
            showNotification('Please fill in all fields to search availability.', 'error');
            return;
        }

        // Validate dates first
        if (!validateBookingDates()) {
            return;
        }

        // Check availability via AJAX
        $.ajax({
            url: '/Scheduler/CheckBookings',
            type: 'GET',
            data: {
                startDate: checkin,
                endDate: checkout,
                homeId: propertyId
            },
            success: function (data) {
                const homeName = getHomeName(propertyId);
                const dateRange = `${new Date(checkin).toLocaleDateString()} - ${new Date(checkout).toLocaleDateString()}`;

                if (data) {
                    showNotification(
                        `${homeName} is already booked for ${dateRange}. Please select different dates.`,
                        "error"
                    );
                } else {
                    showNotification(
                        `${homeName} is available for ${dateRange}! You can proceed with booking.`,
                        "success"
                    );
                    showBookingOption(propertyId, checkin, checkout, homeName);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error checking availability:", error);
                showNotification("Error checking availability. Please try again.", "error");
            }
        });
    }

    function getHomeName(homeId) {
        // First try to get from model data
        const home = window.websiteData.homes.find(h => h.id == homeId);
        if (home) {
            return home.name;
        }
        
        // Fallback to select option
        const homeSelector = document.getElementById('property');
        for (let option of homeSelector.options) {
            if (option.value === homeId) {
                return option.text;
            }
        }
        return `Property ${homeId}`;
    }

    function showNotification(message, type = 'info', duration = 5000) {
        // Remove existing notifications
        const existingNotifications = document.querySelectorAll('.notification');
        existingNotifications.forEach(notification => {
            notification.remove();
        });

        const iconMap = {
            'success': '✅',
            'error': '❌',
            'info': 'ℹ️',
            'warning': '⚠️'
        };

        const notification = document.createElement('div');
        notification.className = `notification ${type}`;
        notification.innerHTML = `
            <span class="notification-icon">${iconMap[type] || iconMap.info}</span>
            <span class="notification-message">${message}</span>
            <button class="notification-close" onclick="closeNotification(this)">&times;</button>
        `;

        document.body.appendChild(notification);

        if (duration > 0) {
            setTimeout(() => {
                closeNotification(notification.querySelector('.notification-close'));
            }, duration);
        }
    }

    function closeNotification(closeButton) {
        const notification = closeButton.parentElement;
        notification.classList.add('slide-out');
        setTimeout(() => {
            notification.remove();
        }, 300);
    }

    function showBookingOption(propertyId, checkin, checkout, homeName) {
        // Create and show booking button
        const existingActions = document.querySelector('.availability-actions');
        if (existingActions) {
            existingActions.remove();
        }

        const bookingActions = document.createElement('div');
        bookingActions.className = 'availability-actions';
        bookingActions.innerHTML = `
            <button class="book-now-btn" onclick="openBookingModal('${propertyId}', '${checkin}', '${checkout}', '${homeName}')">
                    <i class="fas fa-calendar-plus"></i> Book Your Stay
            </button>
        `;

        // Insert after the booking form
        document.querySelector('.booking-form').after(bookingActions);
    }

    function openBookingModal(propertyId, checkin, checkout, homeName) {
        // Populate modal with data
        document.getElementById('HomeId').value = propertyId;
        document.getElementById('BookingDateFrom').value = checkin;
        document.getElementById('BookingDateTo').value = checkout;
        document.getElementById('SelectedProperty').value = homeName;

        // Calculate days and pricing
        const checkInDate = new Date(checkin);
        const checkOutDate = new Date(checkout);
        const timeDiff = checkOutDate.getTime() - checkInDate.getTime();
        const totalDays = Math.ceil(timeDiff / (1000 * 3600 * 24));

        // Get pricing from model data
        const pricePerDay = getPriceForProperty(propertyId);
        const totalPrice = pricePerDay * totalDays;

        document.getElementById('TotalDays').value = totalDays;
        document.getElementById('TotalPrice').value = totalPrice;

        // Update summary display
        updateBookingSummary(homeName, checkin, checkout, totalDays, pricePerDay, totalPrice);

        // Reset room selection
        selectedRooms = [];
        localStorage.removeItem('selectedRoomData');
        updateRoomSelectionDisplay([], false);

        // Show modal
        const modal = document.getElementById('bookingModal');
        if (typeof bootstrap !== 'undefined') {
            const bookingModal = new bootstrap.Modal(modal);
            bookingModal.show();
        } else {
            modal.style.display = 'block';
            modal.classList.add('show');
        }
    }

    function getPriceForProperty(propertyId) {
        // Get price from model data
        const home = window.websiteData.homes.find(h => h.id == propertyId);
        return home ? (home.pricePerDay || 100) : 100;
    }

    function updateBookingSummary(propertyName, checkin, checkout, days, pricePerDay, totalPrice) {
        const bookingDetails = document.getElementById('bookingDetails');
        const totalPriceDisplay = document.getElementById('totalPriceDisplay');
        const selectedRooms = JSON.parse(localStorage.getItem('selectedRoomData') || '[]');
        
        // Calculate pricing based on room selection
        let finalPrice = totalPrice;
        let rateDescription = `${formatPrice(pricePerDay)}/night (Entire Property)`;
        let isIndividualRoomBooking = false;
        
        if (selectedRooms.length > 0) {
            // Calculate price for selected rooms
            const roomTotal = selectedRooms.reduce((sum, room) => sum + (room.Price || 0), 0);
            if (roomTotal > 0) {
                finalPrice = roomTotal * days;
                rateDescription = `${formatPrice(roomTotal)}/night (Selected Rooms)`;
                isIndividualRoomBooking = true;
            }
        }

        let roomBreakdown = '';
        if (isIndividualRoomBooking && selectedRooms.length > 0) {
            roomBreakdown = `
                <div class="booking-detail-item">
                    <strong>Selected Rooms:</strong>
                    <ul class="mt-1 mb-0">
                        ${selectedRooms.map(room => 
                            `<li>${room.Label} - ${formatPrice(room.Price)}/night</li>`
                        ).join('')}
                    </ul>
                </div>
            `;
        }

        bookingDetails.innerHTML = `
            <div class="booking-detail-item">
                <strong>Property:</strong> ${propertyName}
            </div>
            <div class="booking-detail-item">
                <strong>Check-in:</strong> ${new Date(checkin).toLocaleDateString()}
            </div>
            <div class="booking-detail-item">
                <strong>Check-out:</strong> ${new Date(checkout).toLocaleDateString()}
            </div>
            <div class="booking-detail-item">
                <strong>Duration:</strong> ${days} night${days > 1 ? 's' : ''}
            </div>
            ${roomBreakdown}
            <div class="booking-detail-item">
                <strong>Rate:</strong> ${rateDescription}
            </div>
        `;

        totalPriceDisplay.innerHTML = `Total: ${formatPrice(finalPrice)}`;
        
        // Update hidden field
        document.getElementById('TotalPrice').value = finalPrice;
    }

    // ENHANCED VALIDATION FUNCTIONS
    function showValidationMessage(fieldId, message) {
        const field = document.getElementById(fieldId);
        const feedback = document.getElementById(fieldId + '-feedback');
        
        if (!field || !feedback) return;
        
        field.classList.remove('is-invalid');
        feedback.style.display = 'none';
        
        if (message) {
            field.classList.add('is-invalid');
            feedback.textContent = message;
            feedback.style.display = 'block';
        }
    }

    function clearValidationMessage(fieldId) {
        const field = document.getElementById(fieldId);
        const feedback = document.getElementById(fieldId + '-feedback');
        
        if (!field || !feedback) return;
        
        field.classList.remove('is-invalid');
        feedback.style.display = 'none';
    }

    function validateCustomerName() {
        const name = document.getElementById('CustomerName').value.trim();
        
        if (!name) {
            showValidationMessage('CustomerName', 'Customer name is required');
            return false;
        }
        
        if (name.length < 2) {
            showValidationMessage('CustomerName', 'Name must be at least 2 characters long');
            return false;
        }
        
        if (name.length > 100) {
            showValidationMessage('CustomerName', 'Name must not exceed 100 characters');
            return false;
        }
        
        if (!/^[a-zA-Z\s'-]+$/.test(name)) {
            showValidationMessage('CustomerName', 'Name can only contain letters, spaces, hyphens and apostrophes');
            return false;
        }
        
        clearValidationMessage('CustomerName');
        return true;
    }

    function validateEmail() {
        const email = document.getElementById('CustomerEmail').value.trim();
        
        if (!email) {
            showValidationMessage('CustomerEmail', 'Email address is required');
            return false;
        }
        
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$$/;
        if (!emailRegex.test(email)) {
            showValidationMessage('CustomerEmail', 'Please enter a valid email address');
            return false;
        }
        
        if (email.length > 255) {
            showValidationMessage('CustomerEmail', 'Email address is too long');
            return false;
        }
        
        clearValidationMessage('CustomerEmail');
        return true;
    }

    function validatePhone() {
        const phone = document.getElementById('CustomerPhone').value.trim();
        
        if (!phone) {
            showValidationMessage('CustomerPhone', 'Phone number is required');
            return false;
        }
        
        const cleanPhone = phone.replace(/[\s\-\(\)\+]/g, '');
        
        if (cleanPhone.length < 10) {
            showValidationMessage('CustomerPhone', 'Phone number must be at least 10 digits');
            return false;
        }
        
        if (cleanPhone.length > 15) {
            showValidationMessage('CustomerPhone', 'Phone number must not exceed 15 digits');
            return false;
        }
        
        if (!/^\d+$/.test(cleanPhone)) {
            showValidationMessage('CustomerPhone', 'Phone number can only contain digits, spaces, hyphens, and brackets');
            return false;
        }
        
        clearValidationMessage('CustomerPhone');
        return true;
    }

    function validateGuestNumbers() {
        const guests = document.getElementById('GuestNumbers').value.trim();
        
        if (!guests) {
            showValidationMessage('GuestNumbers', 'Number of guests is required');
            return false;
        }
        
        const guestCount = parseInt(guests);
        
        if (isNaN(guestCount) || guestCount < 1) {
            showValidationMessage('GuestNumbers', 'At least 1 guest is required');
            return false;
        }
        
        if (guestCount > 50) {
            showValidationMessage('GuestNumbers', 'Maximum 50 guests allowed');
            return false;
        }
        
        clearValidationMessage('GuestNumbers');
        return true;
    }

    function validateDateRange() {
        const startDate = document.getElementById('BookingDateFrom').value;
        const endDate = document.getElementById('BookingDateTo').value;
        const today = new Date().toISOString().split('T')[0];
        
        let isStartValid = true;
        let isEndValid = true;
        
        if (!startDate) {
            showValidationMessage('BookingDateFrom', 'Check-in date is required');
            isStartValid = false;
        } else if (startDate < today) {
            showValidationMessage('BookingDateFrom', 'Check-in date cannot be in the past');
            isStartValid = false;
        } else {
            clearValidationMessage('BookingDateFrom');
        }
        
        if (!endDate) {
            showValidationMessage('BookingDateTo', 'Check-out date is required');
            isEndValid = false;
        } else if (endDate < today) {
            showValidationMessage('BookingDateTo', 'Check-out date cannot be in the past');
            isEndValid = false;
        } else if (startDate && endDate <= startDate) {
            showValidationMessage('BookingDateTo', 'Check-out date must be after check-in date');
            isEndValid = false;
        } else {
            if (startDate) {
                const start = new Date(startDate);
                const end = new Date(endDate);
                const daysDiff = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
                
                if (daysDiff > 365) {
                    showValidationMessage('BookingDateTo', 'Booking duration cannot exceed 1 year');
                    isEndValid = false;
                } else {
                    clearValidationMessage('BookingDateTo');
                }
            } else {
                clearValidationMessage('BookingDateTo');
            }
        }
        
        return isStartValid && isEndValid;
    }

    function validateFileUpload() {
        const fileInput = document.getElementById('Document');
        const file = fileInput.files[0];
        
        if (file) {
            const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
            const maxSize = 5 * 1024 * 1024; // 5MB
            
            if (!allowedTypes.includes(file.type)) {
                showValidationMessage('Document', 'Invalid file type. Please upload PDF, JPG, PNG, or DOC files');
                fileInput.value = '';
                return false;
            }
            
            if (file.size > maxSize) {
                showValidationMessage('Document', 'File size must be less than 5MB');
                fileInput.value = '';
                return false;
            }
            
            clearValidationMessage('Document');
        } else {
            clearValidationMessage('Document');
        }
        
        return true;
    }

    function validateMessage() {
        const message = document.getElementById('Message').value.trim();
        const maxLength = 500;
        const counter = document.getElementById('Message-count');
        
        if (counter) {
            counter.textContent = `${message.length}/${maxLength} characters`;
        }
        
        if (message.length > maxLength) {
            showValidationMessage('Message', `Message must not exceed ${maxLength} characters`);
            return false;
        }
        
        clearValidationMessage('Message');
        return true;
    }

    // Enhanced form validation function
    function validateForm() {
        let isValid = true;
        
        const validations = [
            validateCustomerName(),
            validateEmail(),
            validatePhone(),
            validateGuestNumbers(),
            validateDateRange(),
            validateFileUpload(),
            validateMessage()
        ];
        
        isValid = validations.every(validation => validation === true);
        
        if (!isValid) {
            const firstInvalidField = document.querySelector('.is-invalid');
            if (firstInvalidField) {
                firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstInvalidField.focus();
            }
        }
        
        return isValid;
    }

    // Initialize validation event listeners
    function initializeWebsiteValidation() {
        // Customer Name validation
        document.getElementById('CustomerName').addEventListener('blur', validateCustomerName);
        document.getElementById('CustomerName').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                validateCustomerName();
            } else {
                clearValidationMessage('CustomerName');
            }
        });

        // Email validation
        document.getElementById('CustomerEmail').addEventListener('blur', validateEmail);
        document.getElementById('CustomerEmail').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                validateEmail();
            } else {
                clearValidationMessage('CustomerEmail');
            }
        });

        // Phone validation
        document.getElementById('CustomerPhone').addEventListener('blur', validatePhone);
        document.getElementById('CustomerPhone').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                validatePhone();
            } else {
                clearValidationMessage('CustomerPhone');
            }
        });

        // Guest numbers validation
        document.getElementById('GuestNumbers').addEventListener('blur', validateGuestNumbers);
        document.getElementById('GuestNumbers').addEventListener('input', validateGuestNumbers);

        // Date validation
        document.getElementById('BookingDateFrom').addEventListener('change', validateDateRange);
        document.getElementById('BookingDateTo').addEventListener('change', validateDateRange);

        // File upload validation
        document.getElementById('Document').addEventListener('change', function() {
            handleFileUpload(this);
            validateFileUpload();
        });

        // Message validation with character counter
        document.getElementById('Message').addEventListener('input', validateMessage);
        document.getElementById('Message').addEventListener('blur', validateMessage);

        // Initialize character counter
        validateMessage();
    }

    function saveBookingData() {
        if (!validateForm()) {
            showNotification('Please correct the validation errors before submitting.', 'error');
            return;
        }

        const selectedRooms = JSON.parse(localStorage.getItem('selectedRoomData') || '[]');
        const submitBtn = document.getElementById('saveBookingBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

        $.ajax({
            url: '/Scheduler/SaveBooking',
            type: 'POST',
            data: {
                'BookingData.CustomerName': document.getElementById('CustomerName').value.trim(),
                'BookingData.CustomerEmail': document.getElementById('CustomerEmail').value.trim(),
                'BookingData.CustomerPhone': document.getElementById('CustomerPhone').value.trim(),
                'BookingData.Message': document.getElementById('Message').value.trim(),
                'BookingData.BookingDateFrom': document.getElementById('BookingDateFrom').value,
                'BookingData.BookingDateTo': document.getElementById('BookingDateTo').value,
                'BookingData.HomeId': document.getElementById('HomeId').value,
                'BookingData.PaymentStatus': "pending",
                'BookingData.CreatedAt': new Date().toISOString(),
                'BookingData.Price': document.getElementById('TotalPrice').value,
                'BookingData.GuestNumbers': document.getElementById('GuestNumbers').value,
                'BookingData.Document': document.getElementById('Document').files[0] ? document.getElementById('Document').files[0].name : null,
                'BookingData.IsBooked': false,
                'BookingData.CheckOut': false,
                'BookingData.TotalDays': document.getElementById('TotalDays').value,
                'Rooms': JSON.stringify(selectedRooms)
            },
            success: function (response) {
                if (response.success) {
                    showNotification('Booking saved! Redirecting to payment...', 'success');
                    $('#bookingModal').modal('hide');

                    // Redirect to payment page after 1.5 seconds
                    setTimeout(function () {
                        window.location.href = `/Payment/InitiatePayment?bookingId=${response.bookingId}`;
                    }, 1500);
                } else {
                    showNotification(response.message || 'Failed to save booking.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            },
            error: function (xhr, status, error) {
                console.error('Booking submission error:', error);
                let errorMessage = 'Error saving booking. Please try again.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                }
                showNotification(errorMessage, 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    }
    function resetForm() {
        document.getElementById('bookingForm').reset();
        
        // Clear all validation states and feedback messages
        document.querySelectorAll('.form-control, .form-select').forEach(field => {
            field.classList.remove('is-invalid');
        });
        
        document.querySelectorAll('.invalid-feedback').forEach(feedback => {
            feedback.style.display = 'none';
        });

        // Reset file upload label
        const label = document.getElementById('documentLabel');
        const fileInfo = label.querySelector('.file-info');
        if (label && fileInfo) {
            label.classList.remove('has-file');
            fileInfo.innerHTML = 'Click to upload document (PDF, JPG, PNG, DOC)';
        }

        // Clear room selection
        localStorage.removeItem('selectedRoomData');
        selectedRooms = [];
        updateRoomSelectionDisplay([], false);

        // Reset character counter
        validateMessage();
    }

