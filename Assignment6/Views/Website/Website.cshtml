    function openRoomSelection() {
        const homeId = document.getElementById('HomeId').value;
        if (!homeId) {
            showNotification('Please select a property first', 'error');
            return;
        }
        
        // Load rooms for the selected property
        loadRoomsForProperty(homeId);
        
        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('roomSelectionModal'));
        modal.show();
    }

    function loadRoomsForProperty(homeId) {
        const container = document.getElementById('roomListContainer');
        container.innerHTML = `
            <div class="text-center p-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2">Loading rooms...</div>
            </div>
        `;
        
        // Get rooms from the model data
        const rooms = window.websiteData.rooms.filter(r => r.homeId == homeId);
        
        // Small delay for UX
        setTimeout(() => displayRooms(rooms), 500);
    }

    function displayRooms(rooms) {
        const container = document.getElementById('roomListContainer');

        let html = `
            <div class="row">
                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="bookingType" id="entireProperty" value="entire" checked>
                        <label class="form-check-label fw-bold" for="entireProperty">
                            <i class="fas fa-home text-primary"></i> Book Entire Property
                        </label>
                        <div class="text-muted small ms-4">Get access to all rooms and facilities - Can book anytime</div>
                    </div>
                </div>
        `;

        // Only show individual room selection if rooms are available
        if (rooms.length > 0) {
            html += `
                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="bookingType" id="selectiveRooms" value="selective">
                        <label class="form-check-label fw-bold" for="selectiveRooms">
                            <i class="fas fa-list text-success"></i> Select Individual Rooms
                        </label>
                        <div class="text-muted small ms-4">
                            Choose specific bedrooms only - Must book within 3 days of stay
                            <div class="alert alert-warning mt-2 p-2">
                                <small><i class="fas fa-info-circle"></i> Individual room booking is only available 3 days before your check-in date</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="roomCheckboxes" class="mt-3" style="display: none;">
                <div class="row">
            `;

            rooms.forEach(room => {
                const isChargeable = room.price > 0;
                const roomPrice = room.price || 0;

                // Determine if room is selectable (only bedrooms)
                const roomType = room.label;
                const isBedroom = roomType.includes('bedroom') || roomType.includes('bed') ||
                    roomType.includes('suite') || roomType.includes('room');
                const isSelectableRoom = isBedroom &&
                    !roomType.includes('hall') &&
                    !roomType.includes('balcony') &&
                    !roomType.includes('living') &&
                    !roomType.includes('kitchen');

                html += `
                    <div class="col-md-6 mb-3">
                        <div class="card room-card ${isChargeable ? 'border-primary' : 'border-secondary'} ${!isSelectableRoom ? 'opacity-50' : ''}">
                            <div class="card-body">
                                <div class="form-check">
                                    <input class="form-check-input room-checkbox" type="checkbox"
                                           id="room_${room.id}" value="${room.id}"
                                           data-name="${room.label}" data-price="${roomPrice}"
                                           ${!isSelectableRoom ? 'disabled' : ''}>
                                    <label class="form-check-label" for="room_${room.id}">
                                        <strong>${room.label}</strong>
                                        ${isChargeable ?
                            `<span class="badge bg-primary ms-2">${formatPrice(roomPrice)}/night</span>` :
                            '<span class="badge bg-secondary ms-2">Free</span>'
                        }
                                        ${!isSelectableRoom ?
                            '<span class="badge bg-warning ms-2">Not Selectable</span>' :
                            ''
                        }
                                    </label>
                                    ${!isSelectableRoom ?
                            '<div class="text-muted small">Only bedrooms can be selected individually</div>' :
                            ''
                        }
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += `
                </div>
            </div>
            `;
        } else {
            html += `
            </div>
            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle"></i>
                <strong>Room details not configured.</strong><br>
                You can book the entire property which includes all available accommodations.
            </div>
            `;
        }

        container.innerHTML = html;

        // Add event listeners
        document.querySelectorAll('input[name="bookingType"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const roomCheckboxes = document.getElementById('roomCheckboxes');
                if (roomCheckboxes) {
                    if (this.value === 'selective') {
                        // Check if dates are within 3-day restriction for individual rooms
                        if (!validateIndividualRoomBookingDates()) {
                            // Reset to entire property if dates don't meet requirement
                            document.getElementById('entireProperty').checked = true;
                            roomCheckboxes.style.display = 'none';
                            return;
                        }
                        roomCheckboxes.style.display = 'block';
                    } else {
                        roomCheckboxes.style.display = 'none';
                        // Clear all room selections
                        document.querySelectorAll('.room-checkbox').forEach(cb => cb.checked = false);
                    }
                }
            });
        });
    }

    function confirmRoomSelection() {
        const bookingType = document.querySelector('input[name="bookingType"]:checked').value;

        if (bookingType === 'entire') {
            // Entire property booking - no date restrictions
            selectedRooms = [];
            localStorage.setItem('selectedRoomData', JSON.stringify([]));
            updateRoomSelectionDisplay([], true);
        } else {
            // Individual room booking - validate 3-day rule
            if (!validateIndividualRoomBookingDates()) {
                showNotification('Individual room booking requires check-in within 3 days. Switching to entire property booking.', 'warning');
                document.getElementById('entireProperty').checked = true;
                selectedRooms = [];
                localStorage.setItem('selectedRoomData', JSON.stringify([]));
                updateRoomSelectionDisplay([], true);
            } else {
                // Selective room booking - only get enabled checkboxes
                const checkedRooms = document.querySelectorAll('.room-checkbox:checked:not([disabled])');

                if (checkedRooms.length === 0) {
                    showNotification('Please select at least one bedroom or switch to entire property booking.', 'warning');
                    return;
                }

                selectedRooms = Array.from(checkedRooms).map(cb => {
                    const roomId = parseInt(cb.value);
                    const roomData = window.websiteData.rooms.find(r => r.id === roomId);

                    return {
                        Id: roomId,
                        Label: roomData ? roomData.label : cb.dataset.name,
                        Price: roomData ? (roomData.price || 0) : parseFloat(cb.dataset.price || 0),
                        HomeId: roomData ? roomData.homeId : null
                    };
                });
                localStorage.setItem('selectedRoomData', JSON.stringify(selectedRooms));
                updateRoomSelectionDisplay(selectedRooms, false);
            }
        }

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('roomSelectionModal'));
        modal.hide();

        // Update pricing with corrected calculation
        const propertyId = document.getElementById('HomeId').value;
        const checkin = document.getElementById('BookingDateFrom').value;
        const checkout = document.getElementById('BookingDateTo').value;
        const homeName = getHomeName(propertyId);

        if (checkin && checkout && propertyId) {
            const checkInDate = new Date(checkin);
            const checkOutDate = new Date(checkout);
            const timeDiff = checkOutDate.getTime() - checkInDate.getTime();
            const totalDays = Math.ceil(timeDiff / (1000 * 3600 * 24));
            
            // Get property base price
            const propertyPricePerDay = getPriceForProperty(propertyId);
            
            let finalPrice;
            if (selectedRooms.length > 0) {
                // Individual room pricing
                const roomTotal = selectedRooms.reduce((sum, room) => sum + (room.Price || 0), 0);
                finalPrice = roomTotal * totalDays;
            } else {
                // Entire property pricing
                finalPrice = propertyPricePerDay * totalDays;
            }

            updateBookingSummary(homeName, checkin, checkout, totalDays, propertyPricePerDay, finalPrice);

            document.getElementById('SelectedRoomIds').value = selectedRooms.map(room => room.Id).join(',');
            document.getElementById('SelectedRoomData').value = JSON.stringify(selectedRooms);
        }
    }

    function updateRoomSelectionDisplay(rooms, isEntireProperty) {
        const badge = document.getElementById('roomSelectionBadge');
        const summary = document.getElementById('roomSelectionSummary');
        const display = document.getElementById('selectedRoomsDisplay');
        
        if (isEntireProperty) {
            badge.textContent = 'Full';
            badge.className = 'room-badge bg-success';
            badge.classList.remove('d-none');
            
            display.innerHTML = '<strong>Entire Property Selected</strong><br><small class="text-muted">Access to all rooms and facilities</small>';
            summary.classList.remove('d-none');
        } else if (rooms.length > 0) {
            badge.textContent = rooms.length;
            badge.className = 'room-badge bg-warning';
            badge.classList.remove('d-none');
            
            const roomNames = rooms.map(r => r.Label).join(', ');
            display.innerHTML = `<strong>Selected Rooms:</strong><br>${roomNames}`;
            summary.classList.remove('d-none');
        } else {
            badge.classList.add('d-none');
            summary.classList.add('d-none');
        }
    }

