    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
 <script>
    $(document).ready(function () {
        if (localStorage.getItem('IsLoggedIn') == "true") {
            window.location.href = "/Login/Login";
        }
        
        // Initialize validation
        initializeWebsiteValidation();
    });

    /// Fixed Calendar Implementation
    var calendarEl = document.getElementById('websiteCalendar');
    var calendar;

    // Initialize calendar with booking data
    function initializeCalendar() {
        if (calendar) {
            calendar.destroy();
        }

        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth'
            },
            height: 'auto',
            selectable: false,
            eventDisplay: 'none',
            dayMaxEvents: false,
            events: [],
            dayCellDidMount: function (info) {
                // Add booking status to each day cell
                addBookingStatus(info.el, info.date);
            },
            datesSet: function () {
                // Refresh status when month changes
                setTimeout(() => {
                    document.querySelectorAll('.fc-daygrid-day').forEach(dayEl => {
                        const dateStr = dayEl.getAttribute('data-date');
                        if (dateStr) {
                            const date = new Date(dateStr);
                            addBookingStatus(dayEl, date);
                        }
                    });
                }, 100);
            }
        });

        calendar.render();
        loadBookingData();
    }

    // Load booking data and update calendar
    function loadBookingData() {
        // Get ALL bookings from your model with home names
        const allBookings = @Html.Raw(Json.Serialize(Model.Bookings.Select(b => new
        {
            id = b.Id,
            homeId = b.HomeId,
            homeName = Model.Homes.FirstOrDefault(h => h.Id == b.HomeId).Name ?? "Unknown Property",
            dateFrom = b.BookingDateFrom.ToString("yyyy-MM-dd"),
            dateTo = b.BookingDateTo.ToString("yyyy-MM-dd"),
            isBooked = b.IsBooked,
            paymentStatus = b.PaymentStatus ?? "pending"
        })));

        // Debug: Log all bookings
        console.log('=== ALL BOOKINGS FROM SERVER ===');
        allBookings.forEach((booking, index) => {
            console.log(`Booking ${index + 1}:`, {
                id: booking.id,
                homeName: booking.homeName,
                dateFrom: booking.dateFrom,
                dateTo: booking.dateTo,
                isBooked: booking.isBooked,
                paymentStatus: booking.paymentStatus
            });
        });

        // Filter for ONLY confirmed bookings (isBooked = true)
        const confirmedBookings = allBookings.filter(booking => {
            const isConfirmed = booking.isBooked === true;
            console.log(`Booking ${booking.id} - isBooked: ${booking.isBooked} - Confirmed: ${isConfirmed}`);
            return isConfirmed;
        });

        // Debug: Log filtered bookings
        console.log('=== CONFIRMED BOOKINGS AFTER FILTER ===');
        console.log('Total confirmed bookings:', confirmedBookings.length);
        confirmedBookings.forEach((booking, index) => {
            console.log(`Confirmed ${index + 1}:`, {
                id: booking.id,
                homeName: booking.homeName,
                dateFrom: booking.dateFrom,
                dateTo: booking.dateTo,
                isBooked: booking.isBooked
            });
        });

        // Process only confirmed booking data for calendar display
        window.bookingCalendarData = processBookingDataWithNames(confirmedBookings);

        // Update calendar display
        updateCalendarDisplay();
    }

    // Process booking data with property names - IMPROVED VERSION
    function processBookingDataWithNames(bookings) {
        const dailyBookings = {};

        console.log('Processing bookings:', bookings.length);

        // Process each confirmed booking
        bookings.forEach((booking, index) => {
            console.log(`Processing booking ${index + 1}:`, {
                id: booking.id,
                homeName: booking.homeName,
                dateFrom: booking.dateFrom,
                dateTo: booking.dateTo,
                isBooked: booking.isBooked
            });

            // Parse dates more reliably
            const startDate = new Date(booking.dateFrom + 'T00:00:00');
            const endDate = new Date(booking.dateTo + 'T00:00:00');

            console.log(`Booking ${booking.id}: ${startDate.toISOString().split('T')[0]} to ${endDate.toISOString().split('T')[0]} (checkout excluded)`);

            // Mark each day in the booking range - EXCLUDE checkout date
            const currentDate = new Date(startDate);
            while (currentDate < endDate) {
                const dateKey = currentDate.toISOString().split('T')[0];

                if (!dailyBookings[dateKey]) {
                    dailyBookings[dateKey] = [];
                }

                // Check if this booking is already added for this date (prevent duplicates)
                const existingBooking = dailyBookings[dateKey].find(b => b.id === booking.id);
                if (!existingBooking) {
                    // Add this booking to the date
                    dailyBookings[dateKey].push({
                        id: booking.id,
                        homeId: booking.homeId,
                        homeName: booking.homeName
                    });
                    console.log(`✓ Added booking ${booking.id} to date ${dateKey}`);
                }

                // Move to next day
                currentDate.setDate(currentDate.getDate() + 1);
            }

            console.log(`✓ Booking ${booking.id} processing complete - checkout date ${endDate.toISOString().split('T')[0]} is available`);
        });

        // Log the final result
        console.log('Daily bookings result:', dailyBookings);
        const totalEntries = Object.values(dailyBookings).reduce((sum, bookings) => sum + bookings.length, 0);
        console.log('Total booking entries across all dates:', totalEntries);

        return dailyBookings;
    }

    // Add booking status to calendar day cell with property names
    function addBookingStatus(dayElement, date) {
        const today = new Date();
        today.setHours(0, 0, 0, 0); // Reset time to start of day
        date.setHours(0, 0, 0, 0);

        // Check if this date is before today
        const isPastDate = date < today;

        if (!window.bookingCalendarData) {
            // If no data loaded yet, show as available (for future dates only)
            dayElement.classList.remove('booked', 'available', 'past-date');
            if (isPastDate) {
                dayElement.classList.add('past-date');
                dayElement.title = 'Past date';
            } else {
                dayElement.classList.add('available');
                dayElement.title = 'Available for booking';
            }
            return;
        }

        const dateKey = date.toISOString().split('T')[0];
        const dayBookings = window.bookingCalendarData[dateKey];

        // Remove existing status classes
        dayElement.classList.remove('booked', 'available', 'past-date');

        // Remove any existing booking info
        const existingInfo = dayElement.querySelector('.booking-info');
        if (existingInfo) {
            existingInfo.remove();
        }

        // Handle past dates - don't show booking information
        if (isPastDate) {
            dayElement.classList.add('past-date');
            dayElement.title = 'Past date';
            return;
        }

        // Handle future dates (today and onwards)
        if (dayBookings && dayBookings.length > 0) {
            // This date has confirmed bookings
            dayElement.classList.add('booked');

            // Create tooltip with property names
            const propertyNames = [...new Set(dayBookings.map(b => b.homeName))];
            const tooltipText = `Booked Properties:\n${propertyNames.join('\n')}`;
            dayElement.title = tooltipText;

            // Add visual indicator with property count if multiple
            if (propertyNames.length > 1) {
                const bookingInfo = document.createElement('div');
                bookingInfo.className = 'booking-info';
                bookingInfo.style.cssText = `
                    position: absolute;
                    top: 2px;
                    left: 2px;
                    background: rgba(255, 255, 255, 0.9);
                    color: #495057;
                    font-size: 10px;
                    padding: 1px 4px;
                    border-radius: 3px;
                    font-weight: bold;
                    z-index: 5;
                `;
                bookingInfo.textContent = `${propertyNames.length} properties`;
                dayElement.style.position = 'relative';
                dayElement.appendChild(bookingInfo);
            } else {
                // Single property - show property name
                const bookingInfo = document.createElement('div');
                bookingInfo.className = 'booking-info';
                bookingInfo.style.cssText = `
                    position: absolute;
                    bottom: 2px;
                    left: 2px;
                    right: 2px;
                    background: rgba(108, 117, 125, 0.9);
                    color: white;
                    font-size: 9px;
                    padding: 1px 2px;
                    border-radius: 2px;
                    font-weight: 500;
                    text-align: center;
                    z-index: 5;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                `;
                bookingInfo.textContent = propertyNames[0];
                dayElement.style.position = 'relative';
                dayElement.appendChild(bookingInfo);
            }
        } else {
            // This date is available
            dayElement.classList.add('available');
            dayElement.title = 'Available for booking';
        }
    }

    // Update calendar display
    function updateCalendarDisplay() {
        if (calendar) {
            calendar.render();

            // Force refresh of day cell status
            setTimeout(() => {
                document.querySelectorAll('.fc-daygrid-day').forEach(dayEl => {
                    const dateStr = dayEl.getAttribute('data-date');
                    if (dateStr) {
                        const date = new Date(dateStr);
                        addBookingStatus(dayEl, date);
                    }
                });
            }, 100);
        }
    }

