<script>
    // Calendar variables
    var currentPropertyFilter = 1;
    var isLoadingBookings = false;
    var allBookingsData = [];
    var calendars = {};
    var isLoadingChunk = false;
    var loadedDateRanges = [];
    var isLoadingMore = false;
    var hasLoadedPastLimit = false; // Track if we've reached the 6-month past limit

    // Generate calendar grid container
    function initializeCalendarGrid() {
        const calendarContainer = document.getElementById('calendar');
        calendarContainer.innerHTML = '';
        calendars = {};
        hasLoadedPastLimit = false; // Reset the limit flag

        const gridWrapper = document.createElement('div');
        gridWrapper.id = 'calendar-grid-wrapper';
        gridWrapper.className = 'calendar-grid-wrapper';

        const currentDate = new Date();

        // Start 6 months BEFORE current month
        const startYear = currentDate.getFullYear();
        const startMonthIndex = currentDate.getMonth() - 6;

        console.log('=== INITIALIZING CALENDAR GRID ===');
        console.log(`Current: ${currentDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);
        console.log(`Starting from: ${new Date(startYear, startMonthIndex, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);

        // Create initial 12 consecutive months (6 past + current + 5 future)
        for (let i = 0; i < 12; i++) {
            const monthDate = new Date(startYear, startMonthIndex + i, 1);
            const monthKey = `${monthDate.getFullYear()}-${monthDate.getMonth()}`;

            console.log(`${i + 1}. Creating: ${monthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })} (${monthKey})`);

            createCalendarMonth(gridWrapper, monthDate, monthKey);
        }

        calendarContainer.appendChild(gridWrapper);

        // Scroll to current month
        setTimeout(() => {
            scrollToCurrentMonth();
        }, 500);
    }

    function createCalendarMonth(container, monthDate, monthKey) {
        // Check if this month already exists
        if (document.querySelector(`[data-month-key="${monthKey}"]`)) {
            console.log(`Month ${monthKey} already exists, skipping`);
            return null;
        }

        const calendarWrapper = document.createElement('div');
        calendarWrapper.className = 'single-calendar-wrapper';
        calendarWrapper.setAttribute('data-month-key', monthKey);
        calendarWrapper.dataset.year = monthDate.getFullYear();
        calendarWrapper.dataset.month = monthDate.getMonth();

        const monthHeader = document.createElement('div');
        monthHeader.className = 'month-header';
        monthHeader.innerHTML = `
            <h4>${monthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</h4>
        `;

        const calendarEl = document.createElement('div');
        calendarEl.className = 'calendar-instance';
        calendarEl.setAttribute('data-month-key', monthKey);

        calendarWrapper.appendChild(monthHeader);
        calendarWrapper.appendChild(calendarEl);
        container.appendChild(calendarWrapper);

        initializeSingleCalendar(calendarEl, monthDate, monthKey);

        return calendarWrapper;
    }

        function initializeSingleCalendar(element, monthDate, monthKey) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const calendar = new FullCalendar.Calendar(element, {
            initialView: 'dayGridMonth',
            initialDate: monthDate,
            selectable: true,
            selectMirror: true,
            eventColor: '#2c3e50',
            height: 'auto',
            headerToolbar: false,
            eventSources: [],
            eventDisplay: 'background',
            displayEventTime: false,
            displayEventEnd: false,
            fixedWeekCount: false,

            // Disable past date selection for new bookings
            selectAllow: function (selectInfo) {
                const selectedStart = new Date(selectInfo.startStr);
                selectedStart.setHours(0, 0, 0, 0);
                const selectedEnd = new Date(selectInfo.endStr);

                // Don't allow selection of past dates for NEW bookings
                if (selectedStart < today) {
                    return false;
                }

                const eventsToCheck = calendar.getEvents().filter(event => {
                    if (currentPropertyFilter) {
                        return event.extendedProps.homeId === currentPropertyFilter;
                    }
                    return true;
                });

                const hasConflict = eventsToCheck.some(event => {
                    const eventStart = new Date(event.startStr);
                    const eventEnd = new Date(event.endStr);
                    // FIXED: Use <= for end date so checkout dates are bookable
                    return (selectedStart < eventEnd && selectedEnd > eventStart);
                });

                return !hasConflict;
            },

            dateClick: function (info) {
                const clickedDate = new Date(info.dateStr);
                clickedDate.setHours(0, 0, 0, 0);

                // FIXED: Check for booking using proper date comparison
                // A booking occupies dates from check-in to check-out (exclusive of checkout date)
                const bookedEvent = calendar.getEvents().find(event => {
                    const eventStart = new Date(event.startStr);
                    eventStart.setHours(0, 0, 0, 0);
                    const eventEnd = new Date(event.endStr);
                    eventEnd.setHours(0, 0, 0, 0);

                    // FIXED: clickedDate >= eventStart && clickedDate < eventEnd
                    // This means checkout date is NOT considered booked
                    const isInDateRange = clickedDate >= eventStart && clickedDate < eventEnd;

                    if (currentPropertyFilter) {
                        return isInDateRange && event.extendedProps.homeId === currentPropertyFilter;
                    }
                    return isInDateRange;
                });

                if (bookedEvent) {
                    // Allow viewing booking details (past or future)
                    showEventDetails(bookedEvent);
                } else {
                    // Only allow NEW bookings on future dates
                    if (clickedDate < today) {
                        showNotification('Cannot create bookings for past dates', 'error', 2000);
                        return;
                    }
                    handleDateClick(info.dateStr);
                }
            },

            dayCellDidMount: function(info) {
                const cellDate = new Date(info.date);
                cellDate.setHours(0, 0, 0, 0);

                // FIXED: Don't add any blocking styles initially
                // Let the eventDidMount handle styling for booked dates
                if (cellDate < today) {
                    info.el.classList.add('fc-day-past-date');
                    // Only add subtle styling, don't block interaction
                    info.el.style.backgroundColor = '#fafafa';
                }
            },

            eventDidMount: function (info) {
                if (info.event.display === 'background') {
                    const dayEl = info.el.closest('.fc-daygrid-day');
                    if (dayEl) {
                        const eventDate = new Date(info.event.startStr);

                        const existingOverlay = dayEl.querySelector('.booking-overlay');
                        if (existingOverlay) {
                            existingOverlay.remove();
                        }

                        dayEl.style.backgroundColor = info.event.backgroundColor;
                        dayEl.style.color = 'white';
                        dayEl.style.cursor = 'pointer';
                        dayEl.style.position = 'relative';
                        dayEl.style.opacity = '1'; // FIXED: Always full opacity for bookings

                        const overlay = document.createElement('div');
                        overlay.className = 'booking-overlay';
                        overlay.dataset.bookingId = info.event.id;

                        const isAirbnb = info.event.extendedProps.isAirbnbBooking;
                        const airbnbIndicator = isAirbnb ? '<div class="airbnb-indicator">🏠 Airbnb</div>' : '';

                        overlay.innerHTML = `
                            ${airbnbIndicator}
                            <div class="booking-customer">${info.event.title}</div>
                            <div class="booking-property">${info.event.extendedProps.homeName}</div>
                            <div class="booking-price">₹${info.event.extendedProps.price}</div>
                        `;

                        dayEl.appendChild(overlay);

                        // FIXED: Allow clicking bookings (past or future) - remove any blocking styles
                        dayEl.addEventListener('click', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            showEventDetails(info.event);
                        });

                        const bookingType = isAirbnb ? 'Airbnb' : 'Manual';
                        $(info.el).tooltip({
                            title: `${bookingType} Booking: ${info.event.title} - ${info.event.extendedProps.homeName} (₹${info.event.extendedProps.price})`,
                            placement: 'top',
                            trigger: 'hover',
                            container: 'body'
                        });
                    }
                }
            },

            eventClick: function (info) {
                showEventDetails(info.event);
            }
        });

        calendar.render();
        calendars[monthKey] = calendar;
    }

    function scrollToCurrentMonth() {
        const currentDate = new Date();
        const currentKey = `${currentDate.getFullYear()}-${currentDate.getMonth()}`;
        const currentMonthElement = document.querySelector(`[data-month-key="${currentKey}"]`);

        if (currentMonthElement) {
            const calendarContainer = document.querySelector('.calendar-container');
            const offsetTop = currentMonthElement.offsetTop - 80;

            calendarContainer.scrollTo({
                top: offsetTop,
                behavior: 'smooth'
            });
        }
    }

    let lastScrollPosition = 0;

    function setupInfiniteScroll() {
        const calendarContainer = document.querySelector('.calendar-container');

        calendarContainer.addEventListener('scroll', function() {
            const scrollTop = this.scrollTop;
            const scrollHeight = this.scrollHeight;
            const clientHeight = this.clientHeight;

            const scrollingDown = scrollTop > lastScrollPosition;
            lastScrollPosition = scrollTop;

            // Load future months (no limit)
            if (scrollingDown && scrollTop + clientHeight >= scrollHeight - 300 && !isLoadingMore) {
                loadMoreMonths('future');
            }

            // Load past months (but only up to 6 months before current)
            if (!scrollingDown && scrollTop <= 300 && !isLoadingMore && !hasLoadedPastLimit) {
                loadMoreMonths('past');
            }
        });
    }

    function loadMoreMonths(direction) {
        if (isLoadingMore) return;

        isLoadingMore = true;
        console.log(`\n=== LOADING MORE MONTHS: ${direction.toUpperCase()} ===`);

        const gridWrapper = document.getElementById('calendar-grid-wrapper');
        const allWrappers = Array.from(gridWrapper.querySelectorAll('.single-calendar-wrapper'));

        if (allWrappers.length === 0) {
            isLoadingMore = false;
            return;
        }

        if (direction === 'future') {
            // Load 6 months forward (unlimited)
            const lastWrapper = allWrappers[allWrappers.length - 1];
            const lastYear = parseInt(lastWrapper.dataset.year);
            const lastMonth = parseInt(lastWrapper.dataset.month);

            const lastDate = new Date(lastYear, lastMonth, 1);
            console.log(`Last calendar: ${lastDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);

            const startDate = new Date(lastYear, lastMonth + 1, 1);
            const endDate = new Date(lastYear, lastMonth + 7, 0);

            console.log('Adding 6 months forward:');

            for (let i = 1; i <= 6; i++) {
                const monthDate = new Date(lastYear, lastMonth + i, 1);
                const monthKey = `${monthDate.getFullYear()}-${monthDate.getMonth()}`;

                console.log(`  ${i}. ${monthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);
                createCalendarMonth(gridWrapper, monthDate, monthKey);
            }

            fetchBookingsForDateRange(startDate, endDate, 'future');

        } else {
            // Load backward - but STOP at 6 months before current date
            const firstWrapper = allWrappers[0];
            const firstYear = parseInt(firstWrapper.dataset.year);
            const firstMonth = parseInt(firstWrapper.dataset.month);

            const firstDate = new Date(firstYear, firstMonth, 1);
            console.log(`First calendar: ${firstDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);

            // Calculate the limit (6 months before current month)
            const currentDate = new Date();
            const limitDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 6, 1);

            console.log(`Limit date (6 months ago): ${limitDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);

            // Check if first calendar is already at or before the limit
            if (firstDate <= limitDate) {
                console.log('✋ Reached 6-month past limit. Not loading more past months.');
                hasLoadedPastLimit = true;
                showNotification('Cannot load bookings older than 6 months', 'info', 3000);
                isLoadingMore = false;
                return;
            }

            const scrollBefore = gridWrapper.scrollHeight;

            // Calculate how many months we can add (max 6, but might be less if near limit)
            const monthsToAdd = Math.min(6, getMonthsDifference(limitDate, firstDate));

            console.log(`Adding ${monthsToAdd} months backward (limit prevents more):`);

            const startDate = new Date(firstYear, firstMonth - monthsToAdd, 1);
            const endDate = new Date(firstYear, firstMonth, 0);

            const monthsToCreate = [];
            for (let i = monthsToAdd; i >= 1; i--) {
                const monthDate = new Date(firstYear, firstMonth - i, 1);

                // Double-check we're not going past the limit
                if (monthDate < limitDate) {
                    console.log(`  Skipping ${monthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })} (before limit)`);
                    hasLoadedPastLimit = true;
                    continue;
                }

                monthsToCreate.push(monthDate);
            }

            monthsToCreate.forEach((monthDate, idx) => {
                const monthKey = `${monthDate.getFullYear()}-${monthDate.getMonth()}`;
                console.log(`  ${idx + 1}. ${monthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`);

                if (document.querySelector(`[data-month-key="${monthKey}"]`)) {
                    console.log(`     Already exists, skipping`);
                    return;
                }

                const calendarWrapper = document.createElement('div');
                calendarWrapper.className = 'single-calendar-wrapper';
                calendarWrapper.setAttribute('data-month-key', monthKey);
                calendarWrapper.dataset.year = monthDate.getFullYear();
                calendarWrapper.dataset.month = monthDate.getMonth();

                const monthHeader = document.createElement('div');
                monthHeader.className = 'month-header';
                monthHeader.innerHTML = `
                    <h4>${monthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</h4>
                `;

                const calendarEl = document.createElement('div');
                calendarEl.className = 'calendar-instance';
                calendarEl.setAttribute('data-month-key', monthKey);

                calendarWrapper.appendChild(monthHeader);
                calendarWrapper.appendChild(calendarEl);
                gridWrapper.insertBefore(calendarWrapper, gridWrapper.firstChild);

                initializeSingleCalendar(calendarEl, monthDate, monthKey);
            });

            const scrollAfter = gridWrapper.scrollHeight;
            const calendarContainer = document.querySelector('.calendar-container');
            calendarContainer.scrollTop += (scrollAfter - scrollBefore);

            if (monthsToCreate.length > 0) {
                fetchBookingsForDateRange(startDate, endDate, 'past');
            }

            // Check if we've reached the limit after adding
            const newFirstWrapper = gridWrapper.querySelector('.single-calendar-wrapper');
            const newFirstYear = parseInt(newFirstWrapper.dataset.year);
            const newFirstMonth = parseInt(newFirstWrapper.dataset.month);
            const newFirstDate = new Date(newFirstYear, newFirstMonth, 1);

            if (newFirstDate <= limitDate) {
                hasLoadedPastLimit = true;
                console.log('✋ Reached limit after this load');
            }
        }

        setTimeout(() => {
            isLoadingMore = false;
        }, 500);
    }

    // Helper function to calculate months difference
    function getMonthsDifference(date1, date2) {
        return (date2.getFullYear() - date1.getFullYear()) * 12 + (date2.getMonth() - date1.getMonth());
    }

    function isDateRangeLoaded(startDate, endDate) {
        return loadedDateRanges.some(range => {
            return startDate >= range.start && endDate <= range.end;
        });
    }

    function fetchBookingsForDateRange(startDate, endDate, direction = 'future') {
        if (isLoadingChunk) return;
        if (isDateRangeLoaded(startDate, endDate)) {
            console.log('Date range already loaded');
            return;
        }

        isLoadingChunk = true;

        const formattedStart = formatDateForAPI(startDate);
        const formattedEnd = formatDateForAPI(endDate);

        console.log(`Fetching bookings: ${formattedStart} to ${formattedEnd}`);

        let url = `/Scheduler/GetBookings?startDate=${formattedStart}&endDate=${formattedEnd}`;
        if (currentPropertyFilter) {
            url += `&homeId=${currentPropertyFilter}`;
        }

        $.ajax({
            url: url,
            type: 'GET',
            cache: false,
            success: function (data) {
                console.log(`Received ${data.length} bookings`);
                loadedDateRanges.push({ start: startDate, end: endDate });
                allBookingsData = allBookingsData.concat(data);
                addBookingsToDateRange(data, startDate, endDate);
                showNotification(`Loaded ${data.length} bookings`, 'success', 2000);
            },
            error: function () {
                showNotification("Error loading bookings", 'error');
            },
            complete: function () {
                isLoadingChunk = false;
            }
        });
    }

    function formatDateForAPI(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }

    function addBookingsToDateRange(bookings, startDate, endDate) {
        Object.keys(calendars).forEach(monthKey => {
            const calendar = calendars[monthKey];
            if (!calendar) return;

            const [year, month] = monthKey.split('-').map(Number);
            const calendarDate = new Date(year, month, 1);

            if (calendarDate >= startDate && calendarDate <= endDate) {
                addBookingsToCalendar(monthKey, bookings);
            }
        });
    }

    function addBookingsToCalendar(monthKey, bookings) {
        const calendar = calendars[monthKey];
        if (!calendar) return;

        bookings.forEach(booking => {
            if (currentPropertyFilter && booking.homeId !== currentPropertyFilter) {
                return;
            }

            const existingEvent = calendar.getEventById(booking.id);
            if (existingEvent) return;

            const homeName = getHomeName(booking.homeId);
            const roomCount = booking.bookingRooms ? booking.bookingRooms.length : 0;
            const isAirbnb = booking.isAirbnbBooking || booking.customerName === "Airbnb Guest";
            const eventColor = isAirbnb ? '#FF6B35' : '#3498db';

            calendar.addEvent({
                id: booking.id,
                title: booking.customerName,
                start: booking.bookingDateFrom,
                end: booking.bookingDateTo,
                color: eventColor,
                allDay: true,
                display: 'background',
                extendedProps: {
                    customerName: booking.customerName,
                    customerEmail: booking.customerEmail,
                    customerPhone: booking.customerPhone,
                    message: booking.message,
                    price: booking.price,
                    advancePaid: booking.advancePaid,
                    amountToBePaid: booking.amountToBePaid,
                    paymentStatus: booking.paymentStatus,
                    homeId: booking.homeId,
                    homeName: homeName,
                    roomCount: roomCount,
                    bookingRooms: booking.bookingRooms,
                    isAirbnbBooking: isAirbnb
                }
            });
        });
    }

    const additionalCSS = `
    <style>
    .calendar-grid-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 1rem 0;
    }

    .single-calendar-wrapper {
        background: white;
        border-radius: 8px;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid var(--border-color);
    }

    .month-header {
        text-align: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-color);
    }

    .month-header h4 {
        margin: 0;
        color: var(--primary-color);
        font-weight: 600;
        font-size: 1.2rem;
    }

    .calendar-instance {
        min-height: 300px;
    }

    .calendar-container {
        max-height: 75vh !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        position: relative;
    }

    .calendar-container::-webkit-scrollbar {
        width: 8px;
    }

    .calendar-container::-webkit-scrollbar-track {
        background: var(--light-gray);
        border-radius: 4px;
    }

    .calendar-container::-webkit-scrollbar-thumb {
        background: var(--primary-color);
        border-radius: 4px;
    }

    /* FIXED: Past dates WITHOUT bookings - dimmed but not blocking */
    .fc-day-past-date:not(:has(.booking-overlay)) {
        background-color: #fafafa !important;
        opacity: 0.5 !important;
    }

    .fc-day-past-date:not(:has(.booking-overlay)):hover {
        cursor: not-allowed !important;
    }

    .fc-day-past-date:not(:has(.booking-overlay)):hover::before {
        display: none !important;
    }

    /* FIXED: Past dates WITH bookings - fully clickable and visible */
    .fc-day-past-date:has(.booking-overlay) {
        cursor: pointer !important;
        opacity: 1 !important;
        background-color: inherit !important;
    }

    .fc-day-past-date:has(.booking-overlay):hover {
        opacity: 0.9 !important;
        transform: scale(1.01) !important;
        transition: all 0.2s ease !important;
    }

    /* Future dates without bookings - can book */
    .fc-daygrid-day.fc-day-future:not(:has(.booking-overlay)):hover {
        background-color: rgba(44, 62, 80, 0.1) !important;
        cursor: pointer !important;
        transition: background-color 0.2s ease !important;
    }

    .fc-daygrid-day.fc-day-future:not(:has(.booking-overlay)):hover::before {
        content: "Click to book" !important;
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        background: rgba(44, 62, 80, 0.9) !important;
        color: white !important;
        padding: 4px 8px !important;
        border-radius: 4px !important;
        font-size: 0.7rem !important;
        z-index: 10 !important;
        pointer-events: none !important;
    }

    /* Today's date without booking - can book */
    .fc-daygrid-day.fc-day-today:not(:has(.booking-overlay)):hover {
        background-color: rgba(44, 62, 80, 0.1) !important;
        cursor: pointer !important;
    }

    .fc-daygrid-day.fc-day-today:not(:has(.booking-overlay)):hover::before {
        content: "Click to book" !important;
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        background: rgba(44, 62, 80, 0.9) !important;
        color: white !important;
        padding: 4px 8px !important;
        border-radius: 4px !important;
        font-size: 0.7rem !important;
        z-index: 10 !important;
        pointer-events: none !important;
    }

    /* All bookings (past or future) - clickable to view */
    .fc-daygrid-day:has(.booking-overlay) {
        cursor: pointer !important;
    }

    .fc-daygrid-day:has(.booking-overlay):hover {
        opacity: 0.9 !important;
        transform: scale(1.01) !important;
        z-index: 10 !important;
        box-shadow: 0 4px 8px rgba(0,0,0,0.3) !important;
        transition: all 0.2s ease !important;
    }

    .fc-daygrid-day:has(.booking-overlay):hover::before {
        content: "Click to view details" !important;
        position: absolute !important;
        bottom: 2px !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        background: rgba(0,0,0,0.8) !important;
        color: white !important;
        padding: 2px 6px !important;
        border-radius: 3px !important;
        font-size: 0.6rem !important;
        z-index: 10 !important;
        pointer-events: none !important;
    }

    @@media (max-width: 768px) {
        .calendar-container {
            max-height: 70vh !important;
        }

        .calendar-header::after {
            content: '☝️ Scroll to view more months';
            display: block;
            text-align: center;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.5rem;
            padding: 0.5rem;
            background: linear-gradient(180deg, transparent, var(--light-gray), transparent);
            border-radius: 4px;
            animation: scrollHint 3s ease-in-out infinite;
        }

        @@keyframes scrollHint {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        .calendar-container.scrolled .calendar-header::after {
            display: none;
        }
    }
    </style>
    `;

    document.head.insertAdjacentHTML('beforeend', additionalCSS);

    document.getElementById("book").addEventListener("click", function() {
        loadedDateRanges = [];
        allBookingsData = [];
        calendars = {};
        hasLoadedPastLimit = false;
        initializeCalendarGrid();
        loadInitialBookings();
    });

    document.getElementById("make-booking-button").addEventListener("click", function () {
        handleDateClick(new Date().toISOString());
    });

    function showLoading(message = 'Loading...') {
        const spinner = $('#loadingSpinner');
        spinner.find('.loading-text').text(message);
        spinner.removeClass('d-none');
    }

    function hideLoading() {
        $('#loadingSpinner').addClass('d-none');
    }

    function showNotification(message, type = 'info', duration = 5000) {
        const alertClass = type === 'success' ? 'alert-success' :
            type === 'error' ? 'alert-danger' : 'alert-info';
        const iconClass = type === 'success' ? 'fa-check-circle' :
            type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle';

        const notification = $(`
            <div class="alert ${alertClass} alert-dismissible fade show notification" role="alert">
                <i class="fas ${iconClass} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `);

        $('.notification').remove();
        $('body').append(notification);

        if (duration > 0) {
            setTimeout(() => notification.alert('close'), duration);
        }
    }

    window.showNotification = showNotification;

    function handleDateClick(dateStr) {
        showLoading('Loading booking form...');
        $.get('/Scheduler/AddBookingForm', { date: dateStr })
            .done(function (html) {
                $('#modalBody').html(html);
                $('#bookingModal').modal('show');

                const picker = window.currentDatePicker;
                if (picker) {
                    picker.setDate(dateStr);
                }

                const checkIn = new Date(dateStr);
                const checkOut = new Date(checkIn);
                checkOut.setDate(checkIn.getDate() + 1);
                $('#BookingDateFrom').val(checkIn.toISOString().split('T')[0]);
                $('#BookingDateTo').val(checkOut.toISOString().split('T')[0]);

                try {
                    if ($('#modalBody').find('#AdvancePrice').length === 0) {
                        const advHtml = `
                            <div class="mb-3 px-3" id="advancePriceContainer">
                                <label for="AdvancePrice" class="form-label">
                                    <i class="fas fa-money-bill-wave"></i> Advance Price (₹)
                                </label>
                                <input type="number" step="0.01" min="0" id="AdvancePrice" name="AdvancePrice" class="form-control" value="0" />
                            </div>`;

                        const target = $('#modalBody').find('#totalPriceDisplay').closest('.mb-3, .booking-summary').first();
                        if (target && target.length) {
                            target.after(advHtml);
                        } else {
                            $('#modalBody').append(advHtml);
                        }
                    }
                } catch (e) {
                    console.warn('Could not inject AdvancePrice input:', e);
                }
            })
            .fail(function () {
                showNotification('Error loading booking form.', 'error');
            })
            .always(hideLoading);
    }

    function getStatusBadgeClass(status) {
        switch (status?.toLowerCase()) {
            case 'paid':
            case 'completed':
                return 'status-paid';
            case 'pending':
                return 'status-pending';
            case 'cancelled':
                return 'status-cancelled';
            default:
                return 'status-pending';
        }
    }

    function loadInitialBookings() {
        const currentDate = new Date();
        const startDate = new Date(currentDate.getFullYear(), currentDate.getMonth() - 6, 1);
        const endDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + 6, 0);

        fetchBookingsForDateRange(startDate, endDate, 'initial');
    }

    function getHomeName(homeId) {
        const homeSelector = document.getElementById('homeSelector');
        for (let option of homeSelector.options) {
            if (parseInt(option.value) === homeId) {
                return option.text;
            }
        }
        return `Property ${homeId}`;
    }

    $(document).ready(function () {
        const defaultHomeId = parseInt($('#homeSelector').val());
        if (defaultHomeId) {
            currentPropertyFilter = defaultHomeId;
            $('.calendar-title').html(`<i class="fas fa-calendar-week me-2"></i>Booking Calendar - ${getHomeName(defaultHomeId)}`);
        }

        initializeCalendarGrid();
        setupInfiniteScroll();
        loadInitialBookings();

        let hasScrolled = false;
        $('.calendar-container').on('scroll', function() {
            if (!hasScrolled) {
                $(this).addClass('scrolled');
                hasScrolled = true;
            }
        });

        $('#homeSelector').on('change', function () {
            const selectedHomeId = parseInt($(this).val());

            if (selectedHomeId) {
                currentPropertyFilter = selectedHomeId;
                $('.calendar-title').html(`<i class="fas fa-calendar-week me-2"></i>Booking Calendar - ${getHomeName(selectedHomeId)}`);
                showNotification(`Filtering: ${getHomeName(selectedHomeId)}`, 'info', 2000);
            }

            loadedDateRanges = [];
            allBookingsData = [];
            calendars = {};
            hasLoadedPastLimit = false;
            initializeCalendarGrid();
            loadInitialBookings();
        });

        $(document).on('change', '#HomeId', function () {
            const homeId = $(this).val();
            if (!homeId) return;

            $('#bookingModal').modal('hide');

            showLoading('Loading room layout...');
            $.get(`/Scheduler/GetHomeDrawing?homeId=${homeId}`)
                .done(function (html) {
                    $('#homeDrawingContainer').html(html);
                    const homeDrawingModal = new bootstrap.Modal(document.getElementById('homeDrawingModal'));
                    homeDrawingModal.show();

                    $('#homeDrawingModal').on('hidden.bs.modal', function () {
                        setTimeout(() => $('#bookingModal').modal('show'), 300);
                    });
                })
                .fail(function () {
                    showNotification('Error loading room layout.', 'error');
                    $('#bookingModal').modal('show');
                })
                .always(hideLoading);
        });

        $("#searchBookingBtn").on("click", searchBooking);

        $(window).on('bookingSaved', function () {
            loadInitialBookings();
            showNotification('Booking saved!', 'success');
        });
    });

    function searchBooking() {
        const startDate = $("#startBookDate").val();
        const endDate = $("#endBookDate").val();
        const homeId = parseInt($("#homeSelector").val());

        if (!startDate || !endDate || isNaN(homeId)) {
            showNotification("Please select all criteria.", "error");
            return;
        }

        if (new Date(endDate) <= new Date(startDate)) {
            showNotification("Check-out must be after check-in.", "error");
            return;
        }

        showLoading('Checking...');

        $.ajax({
            url: '/Scheduler/CheckBookings',
            type: 'GET',
            data: { startDate, endDate, homeId },
            success: function (data) {
                const homeName = getHomeName(homeId);
                if (data === true) {
                    showNotification(`${homeName} is booked.`, "error");
                } else {
                    showNotification(`${homeName} is available!`, "success");
                }
            },
            error: function () {
                showNotification("Error checking.", "error");
            },
            complete: hideLoading
        });
    }

    const today = new Date().toISOString().split('T')[0];
    document.getElementById('startBookDate').setAttribute('min', today);
    document.getElementById('endBookDate').setAttribute('min', today);

    document.getElementById('startBookDate').addEventListener('change', function () {
        const startDate = this.value;
        const endDateInput = document.getElementById('endBookDate');
        endDateInput.setAttribute('min', startDate);

        if (endDateInput.value && endDateInput.value < startDate) {
            endDateInput.value = '';
        }
    });

    function showEventDetails(event) {
        const props = event.extendedProps;
        const startDate = event.start.toLocaleDateString();
        const endDate = event.end ? event.end.toLocaleDateString() : 'N/A';

        var remainingAmount = props.paymentStatus == 'Paid' ? 0 :
            (typeof props.amountToBePaid !== 'undefined' ? props.amountToBePaid : ((props.price || 0) - (props.advancePaid || 0)));

        let roomDetails = '';
        if (props.bookingRooms && props.bookingRooms.length > 0) {
            roomDetails = '<div class="mt-2"><strong>Rooms:</strong><ul class="mb-0 mt-1">';
            props.bookingRooms.forEach(room => {
                $.ajax({
                    url: '/Scheduler/GetRoomDetailsById',
                    type: 'POST',
                    async: false,
                    data: { roomId: room.roomId },
                    success: function (response) {
                        if (response) roomDetails += `<li>${response}</li>`;
                    }
                });
            });
            roomDetails += '</ul></div>';
        }

        // Check if booking is in the past
        const bookingEndDate = new Date(event.end || event.start);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const isPastBooking = bookingEndDate < today;

        // Check if Airbnb booking
        const isAirbnbBooking = props.customerName === "Airbnb Guest" || props.customerName?.includes("Airbnb");

        let paymentSection = '';
        // Show payment options or invoice generation for all bookings (except Airbnb for payment actions)
        if (!isAirbnbBooking) {
            if (props.paymentStatus && props.paymentStatus.toLowerCase() === 'pending') {
                paymentSection = `
                    <div class="mt-3 p-2 border-top">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="paymentPaidCheck_${event.id}">
                            <label class="form-check-label" for="paymentPaidCheck_${event.id}">
                                <strong>Mark as Paid</strong>
                            </label>
                        </div>
                        <button class="btn btn-success btn-sm w-100 mb-2" onclick="completeBookingWithInvoice(${event.id}, '${props.customerName}')">
                            <i class="fas fa-check me-1"></i>Complete & Invoice
                        </button>
                    </div>
                `;
            } else {
                // For non-pending bookings (paid, completed), allow invoice generation
                paymentSection = `
                    <div class="mt-3 p-2 border-top">
                        <button class="btn btn-primary btn-sm w-100 mb-2" onclick="generateBookingInvoice(${event.id}, '${props.customerName}')">
                            <i class="fas fa-file-pdf me-1"></i>Generate Invoice
                        </button>
                    </div>
                `;
            }
        } else {
            // For Airbnb bookings, always show invoice generation button (no payment tracking)
            paymentSection = `
                <div class="mt-3 p-2 border-top">
                    <button class="btn btn-primary btn-sm w-100 mb-2" onclick="generateBookingInvoice(${event.id}, '${props.customerName}')">
                        <i class="fas fa-file-pdf me-1"></i>Generate Invoice
                    </button>
                </div>
            `;
        }

        const deleteSection = `
            <div class="mt-3 p-2 border-top">
                <button class="btn btn-danger btn-sm w-100" onclick="deleteBooking(${event.id}, '${props.customerName}')">
                    <i class="fas fa-trash me-1"></i>Delete
                </button>
            </div>
        `;

        const pastBadge = isPastBooking ? '<span class="badge bg-secondary ms-2">Past Booking</span>' : '';
        const airbnbBadge = isAirbnbBooking ? '<span class="badge bg-info ms-2">🏠 Airbnb</span>' : '';

        const eventInfo = `
            <div class="event-details">
                <h6 class="mb-2 text-center">
                    <i class="fas fa-calendar-check me-2"></i>${event.title}${pastBadge}${airbnbBadge}
                </h6>
                ${(!isAirbnbBooking ? `<div class="text-center mb-3">
                    <span class="status-badge ${getStatusBadgeClass(props.paymentStatus)}">
                        ${props.paymentStatus || 'Unknown'}
                    </span>
                </div>` : '')}
                <div class="row g-1 small">
                    <div class="col-5"><strong>Customer:</strong></div>
                    <div class="col-7">${props.customerName || 'N/A'}</div>
                    <div class="col-5"><strong>Check-in:</strong></div>
                    <div class="col-7">${startDate}</div>
                    <div class="col-5"><strong>Check-out:</strong></div>
                    <div class="col-7">${endDate}</div>
                    <div class="col-5"><strong>Property:</strong></div>
                    <div class="col-7">${props.homeName || 'N/A'}</div>
                    <div class="col-5"><strong>Total:</strong></div>
                    <div class="col-7"><strong>₹${props.price || 0}</strong></div>
                    ${(!isAirbnbBooking ? `<div class="col-5"><strong>Remaining:</strong></div>
                    <div class="col-7"><strong>₹${remainingAmount}</strong></div>` : '')}
                </div>
                ${roomDetails}
                ${paymentSection}
                ${deleteSection}
            </div>
        `;

        showNotification(eventInfo, 'info', 0);
    }

    // Frontend PDF generation: fetch invoice HTML from backend and render to a single-page A4 PDF
    function downloadInvoice(bookingId) {
        return fetch(`/Scheduler/GetInvoiceHtml?bookingId=${bookingId}`)
            .then(res => {
                if (!res.ok) throw new Error('Failed to load invoice HTML');
                return res.text();
            })
            .then(html => {
                const container = document.createElement('div');
                container.style.position = 'fixed';
                container.style.left = '-10000px';
                container.style.top = '0';
                container.innerHTML = html;
                document.body.appendChild(container);

                const element = container.querySelector('.a4-page') || container;

                return html2canvas(element, { scale: 2, useCORS: true, backgroundColor: '#ffffff' })
                    .then(canvas => {
                        const { jsPDF } = window.jspdf;
                        const pageW = 794;
                        const pageH = 1123;
                        const pdf = new jsPDF({ unit: 'px', format: [pageW, pageH], orientation: 'portrait', hotfixes: ['px_scaling'] });
                        const imgData = canvas.toDataURL('image/png');

                        // Preserve aspect ratio: scale image to fit page width, keep natural height
                        const imgW = pageW;
                        const imgH = (canvas.height * imgW) / canvas.width;
                        // If content fits the page height, render at full width; else scale down to fit height
                        const finalW = imgH <= pageH ? imgW : (canvas.width * pageH) / canvas.height;
                        const finalH = imgH <= pageH ? imgH : pageH;
                        const offsetX = (pageW - finalW) / 2;
                        const offsetY = 0;
                        pdf.addImage(imgData, 'PNG', offsetX, offsetY, finalW, finalH);
                        pdf.save(`Invoice_${bookingId}.pdf`);
                        document.body.removeChild(container);
                    });
            })
            .catch(err => {
                console.error(err);
                showNotification('PDF generation failed', 'error');
            });
    }

    function completeBookingWithInvoice(bookingId, bookingTitle) {
        const checkbox = document.getElementById(`paymentPaidCheck_${bookingId}`);
        if (!checkbox.checked) {
            showNotification('Check the checkbox to confirm.', 'error');
            return;
        }

        if (!confirm(`Generate invoice for: ${bookingTitle}?`)) return;

        showLoading('Generating invoice...');

        $.ajax({
            url: '/Scheduler/CompleteBookingWithInvoice',
            type: 'POST',
            data: { bookingId },
            success: function (response) {
                if (response.success) {
                    showNotification('Invoice generated successfully!', 'success');
                    setTimeout(() => $('.notification').remove(), 2000);
                    setTimeout(() => loadInitialBookings(), 1000);
                    downloadInvoice(bookingId);
                } else {
                    showNotification(response.message || 'Failed to generate invoice.', 'error');
                }
            },
            error: function () {
                showNotification('Error generating invoice.', 'error');
            },
            complete: hideLoading
        });
    }

    function generateBookingInvoice(bookingId, bookingTitle) {
        if (!confirm(`Generate invoice for: ${bookingTitle}?`)) return;

        showLoading('Generating invoice...');
        downloadInvoice(bookingId)
            .then(() => showNotification('Invoice generated successfully!', 'success'))
            .finally(hideLoading);
    }

    function deleteBooking(bookingId, bookingTitle) {
        if (!confirm(`Delete: ${bookingTitle}?`)) return;

        showLoading('Deleting...');

        $.ajax({
            url: '/Scheduler/DeleteBooking',
            type: 'POST',
            data: { bookingId },
            success: function (response) {
                if (response.success) {
                    showNotification('Deleted!', 'success');
                    setTimeout(() => $('.notification').remove(), 2000);
                    setTimeout(() => loadInitialBookings(), 1000);
                } else {
                    showNotification(response.message || 'Failed.', 'error');
                }
            },
            complete: hideLoading
        });
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/signalR")
        .build();

    connection.on("BindBookingFromAirbnb", function (Bookings) {
        try {
            allBookingsData = Bookings;
            Object.values(calendars).forEach(cal => cal && cal.removeAllEvents());
            loadInitialBookings();
        } catch (error) {
            console.error('SignalR error:', error);
        }
    });

    connection.start().catch(err => console.error(err.toString()));
</script>