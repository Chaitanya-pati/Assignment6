                      // Set default check-in and check-out dates
                      const checkIn = new Date(dateStr);
                      const checkOut = new Date(checkIn);
                      checkOut.setDate(checkIn.getDate() + 1);
                      $('#BookingDateFrom').val(checkIn.toISOString().split('T')[0]);
