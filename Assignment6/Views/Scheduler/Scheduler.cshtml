      // REPLACE your existing updatePaymentStatus function with this:
      function completeBookingWithInvoice(bookingId, bookingTitle) {
          const checkbox = document.getElementById(`paymentPaidCheck_${bookingId}`);

          if (!checkbox.checked) {
              showNotification('Please check the "Mark as Paid & Complete" checkbox to confirm.', 'error');
              return;
          }

          if (!confirm(`Are you sure you want to generate an invoice?\n\nBooking: ${bookingTitle}`)) {
              return;
          }

          showLoading('Completing booking and generating invoice...');

          $.ajax({
              url: '/Scheduler/CompleteBookingWithInvoice',
              type: 'POST',
              data: {
                  bookingId: bookingId
              },
              success: function (response) {
                  if (response.success) {
                      showNotification('Invoice generated!!!', 'success');

                      // Remove current notification after showing success
                      setTimeout(() => {
                          $('.notification').remove();
                      }, 2000);

                      // Remove the specific event from calendar immediately
                      const calendarEvent = calendar.getEventById(bookingId);
                      if (calendarEvent) {
                          calendarEvent.remove();
                      }

                      // Refresh calendar to ensure consistency
                      setTimeout(() => {
                          fetchAndDisplayBookings();
                      }, 1000);

                      // Download and open PDF invoice if URL is provided
                      if (response.invoiceUrl) {
                          // Create a temporary download link
                          const downloadLink = document.createElement('a');
                          downloadLink.href = response.invoiceUrl;
                          downloadLink.download = `Invoice_${bookingId}.pdf`;
                          downloadLink.style.display = 'none';

                          // Add to DOM, click it, then remove it
                          document.body.appendChild(downloadLink);
                          downloadLink.click();
                          document.body.removeChild(downloadLink);

                          // Also open in new tab for viewing
                          setTimeout(() => {
                              window.open(response.invoiceUrl, '_blank');
                          }, 500);

                          // Show additional success message
                          setTimeout(() => {
                              showNotification('Invoice downloaded and opened in new tab!', 'info', 3000);
                          }, 1000);
                      }
                  } else {
                      showNotification(response.message || 'Failed to complete booking.', 'error');
                  }
              },
              error: function (xhr, status, error) {
                  console.error('Error completing booking:', error);
                  showNotification('Error completing booking. Please try again.', 'error');
              },
              complete: function () {
                  hideLoading();
              }
          });
      }

