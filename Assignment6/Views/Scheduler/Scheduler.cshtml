      // Updated search booking function in your JavaScript
      // Updated search booking function in your JavaScript
      function searchBooking() {
          const startDate = $("#startBookDate").val();
          const endDate = $("#endBookDate").val();
          const homeId = parseInt($("#homeSelector").val());

          if (!startDate || !endDate || isNaN(homeId)) {
              showNotification("Please select all search criteria.", "error");
              return;
          }

          // Validate that end date is after start date
          if (new Date(endDate) <= new Date(startDate)) {
              showNotification("Check-out date must be after check-in date.", "error");
              return;
          }

          showLoading('Checking availability...');

          $.ajax({
              url: '/Scheduler/CheckBookings',
              type: 'GET',
              data: {
                  startDate: startDate,
                  endDate: endDate,
                  homeId: homeId
              },
              success: function (data) {
                  const homeName = getHomeName(homeId);
                  const dateRange = `${new Date(startDate).toLocaleDateString()} - ${new Date(endDate).toLocaleDateString()}`;

