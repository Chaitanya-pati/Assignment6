              }
          });

      }

      function syncAirbnb() {
          showLoading('Syncing with Airbnb properties...');

          // Show initial progress notification
          showNotification('Starting Airbnb sync for both properties...', 'info', 3000);

          $.ajax({
              url: '/Scheduler/GetBookingsFromAirbnbAndSaveToDb',
              type: 'GET',
              dataType: 'json',
              timeout: 45000, // 45 seconds timeout for large sync operations
              cache: false, // Prevent caching to ensure fresh data
              success: function (response) {
                  console.log("Airbnb sync response:", response);

                  if (response.success) {
                      // Build detailed success message
                      let message = `Airbnb sync completed successfully!`;
                      let details = [];

                      if (response.totalSynced > 0) {
                          details.push(`${response.totalSynced} new bookings synced`);
                      } else {
                          details.push('No new bookings to sync');
                      }

                      // Add error details if any
                      if (response.errors && response.errors.length > 0) {
                          details.push(`${response.errors.length} properties had issues`);
                          console.warn("Sync errors:", response.errors);

                          // Show errors in console for debugging
                          response.errors.forEach(error => {
                              console.error("Property sync error:", error);
                          });
                      }

                      if (details.length > 0) {
                          message += `\n${details.join(', ')}.`;
                      }

                      // Show success notification
                      showNotification(message, 'success', 6000);

                      // Refresh calendar to show new bookings with a delay
                      setTimeout(() => {
                          console.log("Refreshing calendar after Airbnb sync...");
                          fetchAndDisplayBookings();
                      }, 1500);

                      // Optional: Show breakdown by property if available
                      if (response.propertyBreakdown) {
                          console.log("Property sync breakdown:", response.propertyBreakdown);
                      }

                  } else {
                      // Handle sync failure
                      const errorMessage = response.message || 'Unknown error occurred during sync';
                      showNotification(`Airbnb sync failed: ${errorMessage}`, 'error', 8000);
                      console.error("Sync failed with message:", errorMessage);
                  }
              },
              error: function (xhr, status, error) {
                  console.error("Airbnb sync AJAX error:", {
                      status: status,
                      error: error,
                      responseText: xhr.responseText,
                      statusCode: xhr.status
                  });

                  let errorMessage = "Failed to sync with Airbnb";
                  let errorDetails = "";

                  // Provide specific error messages based on the type of error
                  if (status === 'timeout') {
                      errorDetails = "The sync operation timed out. This might happen with large amounts of data.";
                      errorMessage += " (Timeout)";
                  } else if (xhr.status === 500) {
                      errorDetails = "Server encountered an internal error. Please check server logs.";
                      errorMessage += " (Server Error)";
                  } else if (xhr.status === 404) {
                      errorDetails = "Sync endpoint not found. Please check your routing.";
                      errorMessage += " (Not Found)";
                  } else if (xhr.status === 0) {
                      errorDetails = "Network connection failed or request was cancelled.";
                      errorMessage += " (Network Error)";
                  } else if (xhr.status >= 400 && xhr.status < 500) {
                      errorDetails = "Client request error occurred.";
                      errorMessage += ` (Error ${xhr.status})`;
                  } else {
                      errorDetails = "An unexpected error occurred during the sync process.";
                  }

                  // Try to parse error response for more details
                  try {
                      const errorResponse = JSON.parse(xhr.responseText);
                      if (errorResponse.message) {
                          errorDetails = errorResponse.message;
                      }
                  } catch (e) {
                      // Response is not JSON, use default error details
                  }

                  // Show error notification with details
                  showNotification(
                      `${errorMessage}${errorDetails ? '\n' + errorDetails : ''}`,
                      'error',
                      10000
                  );
              },
              complete: function () {
                  hideLoading();
                  console.log("Airbnb sync operation completed");
              }
          });
      }


      // SignalR connection
      const connection = new signalR.HubConnectionBuilder()
          .withUrl("/signalR")
          .build();

      connection.on("BindBookingFromAirbnb", function (Bookings) {
          try {
                  BindSchedulerData(Bookings);
          } catch (error) {
              console.error('Error handling SignalR notification:', error);
          }
      });

      connection.start().catch(function (err) {
          return console.error(err.toString());
      });
          function BindSchedulerData(data) {
            // Clear all existing events first
            calendar.removeAllEvents();
            
            // Transform booking data to events
            data?.forEach(booking => {
                const homeName = getHomeName(booking.homeId);
                const roomCount = booking.bookingRooms ? booking.bookingRooms.length : 0;
                const isAirbnb = booking.isAirbnbBooking || booking.customerName === "Airbnb Guest";

                const startDate = booking.bookingDateFrom;
                const endDate = booking.bookingDateTo;

                // Add new event with blue color (#3498db)
                calendar.addEvent({
                    id: booking.id,
                    title: booking.customerName,
                    start: startDate,
                    end: endDate,
                    color: '#3498db', // Blue color for all bookings
                    allDay: true,
                    display: 'background',
                    extendedProps: {
                        customerName: booking.customerName,
                        customerEmail: booking.customerEmail,
                        customerPhone: booking.customerPhone,
                        message: booking.message,
                        price: booking.price,
                        advancePaid: booking.advancePaid,
                        amountToBePaid: booking.amountToBePaid,
                        paymentStatus: booking.paymentStatus,
                        homeId: booking.homeId,
                        homeName: homeName,
                        roomCount: roomCount,
                        bookingRooms: booking.bookingRooms,
                        isAirbnbBooking: isAirbnb
                    }
                });
            });

            calendar.render(); // re-render view if needed
        }
