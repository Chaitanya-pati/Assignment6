    function searchBooking() {
        const startDate = $("#startBookDate").val();
        const endDate = $("#endBookDate").val();
        const homeId = parseInt($("#homeSelector").val());

        if (!startDate || !endDate || isNaN(homeId)) {
            showNotification("Please select all criteria.", "error");
            return;
        }

        if (new Date(endDate) <= new Date(startDate)) {
            showNotification("Check-out must be after check-in.", "error");
            return;
        }

        showLoading('Checking...');

        $.ajax({
            url: '/Scheduler/CheckBookings',
            type: 'GET',
            data: { startDate, endDate, homeId },
            success: function (data) {
                const homeName = getHomeName(homeId);
                if (data === true) {
                    showNotification(`${homeName} is booked.`, "error");
                } else {
                    showNotification(`${homeName} is available!`, "success");
                }
            },
            error: function () {
                showNotification("Error checking.", "error");
            },
            complete: hideLoading
        });
    }

    const today = new Date().toISOString().split('T')[0];
    document.getElementById('startBookDate').setAttribute('min', today);
    document.getElementById('endBookDate').setAttribute('min', today);

    document.getElementById('startBookDate').addEventListener('change', function () {
        const startDate = this.value;
        const endDateInput = document.getElementById('endBookDate');
        endDateInput.setAttribute('min', startDate);

        if (endDateInput.value && endDateInput.value < startDate) {
            endDateInput.value = '';
        }
    });

    function showEventDetails(event) {
        const props      = event.extendedProps;
        const fmt        = d => d ? new Date(d).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : 'N/A';
        const startDate  = fmt(event.start);
        const endDate    = event.end ? fmt(new Date(event.end.getTime() - 86400000)) : 'N/A'; // FullCalendar end is exclusive
        const totalPrice = props.price || 0;
        const advancePaid = props.advancePaid || 0;
        const remaining  = props.paymentStatus?.toLowerCase() === 'paid' ? 0
            : (typeof props.amountToBePaid !== 'undefined' ? props.amountToBePaid : (totalPrice - advancePaid));

        const bookingEndDate = new Date(event.end || event.start);
        const today = new Date(); today.setHours(0,0,0,0);
        const isPastBooking   = bookingEndDate < today;
        const isAirbnbBooking = props.customerName === 'Airbnb Guest' || props.customerName?.includes('Airbnb');
        const isPaid          = (props.paymentStatus || '').toLowerCase() === 'paid';

        // ── Header badges ─────────────────────────────────────────
        let badgesHtml = '';
        if (!isAirbnbBooking) {
            const chipClass = isPaid ? 'chip-paid' : (props.paymentStatus?.toLowerCase() === 'partial' ? 'chip-partial' : 'chip-pending');
            const chipIcon  = isPaid ? 'fa-check-circle' : 'fa-clock';
            badgesHtml += `<span class="status-chip ${chipClass}"><i class="fas ${chipIcon}"></i>${props.paymentStatus || 'Unknown'}</span>`;
        }
        if (isAirbnbBooking) badgesHtml += `<span class="status-chip chip-airbnb"><i class="fas fa-home"></i>Airbnb</span>`;
        if (isPastBooking)   badgesHtml += `<span class="status-chip chip-past"><i class="fas fa-history"></i>Past</span>`;

        document.getElementById('bdoc_GuestName').textContent = props.customerName || 'Booking';
        document.getElementById('bdoc_Badges').innerHTML = badgesHtml;

        // ── Booking info card ──────────────────────────────────────
        let roomsList = '';
        if (props.bookingRooms && props.bookingRooms.length > 0) {
            props.bookingRooms.forEach(room => {
                $.ajax({ url: '/Scheduler/GetRoomDetailsById', type: 'POST', async: false,
                    data: { roomId: room.roomId },
                    success: r => { if (r) roomsList += `<span class="badge bg-light text-dark border me-1 mb-1" style="font-size:11px;">${r}</span>`; }
                });
            });
        }

        const infoCard = `
            <div class="bdoc-card">
                <div class="bdoc-card-title"><i class="fas fa-info-circle me-1"></i>Booking Info</div>
                <div class="bdoc-row"><span class="bdoc-label">Customer</span><span class="bdoc-value">${props.customerName || 'N/A'}</span></div>
                <div class="bdoc-row"><span class="bdoc-label">Check-in</span><span class="bdoc-value">${startDate}</span></div>
                <div class="bdoc-row"><span class="bdoc-label">Check-out</span><span class="bdoc-value">${endDate}</span></div>
                <div class="bdoc-row"><span class="bdoc-label">Property</span><span class="bdoc-value">${props.homeName || 'N/A'}</span></div>
                ${props.customerPhone ? `<div class="bdoc-row"><span class="bdoc-label">Phone</span><span class="bdoc-value">${props.customerPhone}</span></div>` : ''}
                ${props.guestNumbers  ? `<div class="bdoc-row"><span class="bdoc-label">Guests</span><span class="bdoc-value">${props.guestNumbers}</span></div>` : ''}
                ${roomsList ? `<div class="bdoc-row"><span class="bdoc-label">Rooms</span><span class="bdoc-value d-flex flex-wrap">${roomsList}</span></div>` : ''}
            </div>`;

        // ── Payment summary card ───────────────────────────────────
        const paymentSummaryCard = !isAirbnbBooking ? `
            <div class="bdoc-card">
                <div class="bdoc-card-title"><i class="fas fa-rupee-sign me-1"></i>Payment Summary</div>
                <div class="bdoc-row"><span class="bdoc-label">Total</span><span class="bdoc-value highlight">₹${totalPrice.toLocaleString('en-IN')}</span></div>
                ${advancePaid > 0 ? `<div class="bdoc-row"><span class="bdoc-label">Advance paid</span><span class="bdoc-value success">₹${advancePaid.toLocaleString('en-IN')}${props.paymentMethod ? ` <span style="font-size:10px;color:#6b7a8d;">(${props.paymentMethod})</span>` : ''}</span></div>` : ''}
                ${props.finalPaymentAmount > 0 ? `<div class="bdoc-row"><span class="bdoc-label">Final paid</span><span class="bdoc-value success">₹${(props.finalPaymentAmount||0).toLocaleString('en-IN')}${props.finalPaymentMethod ? ` <span style="font-size:10px;color:#6b7a8d;">(${props.finalPaymentMethod})</span>` : ''}</span></div>` : ''}
                ${remaining > 0 ? `<div class="bdoc-row"><span class="bdoc-label">Balance due</span><span class="bdoc-value danger">₹${remaining.toLocaleString('en-IN')}</span></div>` : ''}
            </div>` : '';

        // ── Payment management card (non-Airbnb, not fully paid) ──
        const paymentMethods = ['Cash', 'UPI', 'Card', 'Online', 'Bank Transfer', 'Pay Later'];

        let paymentManageCard = '';
        if (!isAirbnbBooking && !isPaid) {
            const advMethod = props.paymentMethod      || '';
            const finMethod = props.finalPaymentMethod || '';
            const finAmt    = props.finalPaymentAmount || 0;

            const advMethodOpts = paymentMethods.map(m => `<option value="${m}" ${m===advMethod?'selected':''}>${m}</option>`).join('');
            const finMethodOpts = paymentMethods.map(m => `<option value="${m}" ${m===finMethod?'selected':''}>${m}</option>`).join('');

            paymentManageCard = `
                <div class="bdoc-pay-section">
                    <div class="bdoc-card-title"><i class="fas fa-edit me-1"></i>Update Payments</div>
                    <div class="bdoc-pay-total">
                        <span style="color:#5a6a7a;font-size:12px;">Booking Total</span>
                        <strong>₹${totalPrice.toLocaleString('en-IN')}</strong>
                    </div>
                    <div class="mb-3">
                        <div class="bdoc-field-label"><i class="fas fa-hand-holding-usd" style="color:#2563a8;"></i>Advance / Full Payment</div>
                        <div class="d-flex gap-2">
                            <input type="number" id="advAmt_${event.id}" class="form-control form-control-sm"
                                   placeholder="₹ Amount" value="${advancePaid}" min="0" max="${totalPrice}"
                                   oninput="_bdocSummary('${event.id}',${totalPrice})" style="width:45%;">
                            <select id="advMethod_${event.id}" class="form-select form-select-sm" style="width:55%;">
                                <option value="">-- Method --</option>${advMethodOpts}
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="bdoc-field-label"><i class="fas fa-check-circle" style="color:#198754;"></i>Final / Remaining Payment <span style="font-weight:400;color:#8896a6;font-size:10px;">(optional)</span></div>
                        <div class="d-flex gap-2">
                            <input type="number" id="finalAmt_${event.id}" class="form-control form-control-sm"
                                   placeholder="₹ Amount" value="${finAmt > 0 ? finAmt : ''}" min="0" max="${totalPrice}"
                                   oninput="_bdocSummary('${event.id}',${totalPrice})" style="width:45%;">
                            <select id="finalMethod_${event.id}" class="form-select form-select-sm" style="width:55%;">
                                <option value="">-- Method --</option>${finMethodOpts}
                            </select>
                        </div>
                    </div>
                    <div class="bdoc-live-summary" id="paySummary_${event.id}">
                        <div class="sum-row"><span style="color:#5a6a7a;">Total paid</span><strong id="paySummaryPaid_${event.id}">₹${advancePaid.toLocaleString('en-IN')}</strong></div>
                        <div class="sum-row"><span style="color:#5a6a7a;">Balance</span><strong id="paySummaryBal_${event.id}" style="color:${remaining>0?'#dc3545':'#198754'};">₹${remaining.toLocaleString('en-IN')}</strong></div>
                        <div id="paySummaryStatus_${event.id}" class="text-center mt-1" style="font-size:11px;font-weight:600;color:${remaining===0?'#198754':'#f59e0b'};">
                            ${remaining===0 ? '✓ Fully paid' : (advancePaid>0 ? `Partial — ₹${remaining.toLocaleString('en-IN')} remaining` : '')}
                        </div>
                    </div>
                </div>`;
        }

        // ── Actions card ──────────────────────────────────────────
        const safeTitle = (props.customerName||'').replace(/'/g,"\\'");
        let actionsHtml = '';
        if (!isAirbnbBooking && !isPaid) {
            actionsHtml += `<button class="bdoc-btn bdoc-btn-success" onclick="savePaymentDetails(${event.id},'${safeTitle}',${totalPrice})"><i class="fas fa-save"></i>Save Payment</button>`;
        }
        actionsHtml += `<button class="bdoc-btn bdoc-btn-primary" onclick="generateBookingInvoice(${event.id},'${safeTitle}')"><i class="fas fa-file-pdf"></i>Generate Invoice</button>`;
        actionsHtml += `<button class="bdoc-btn bdoc-btn-danger" onclick="deleteBooking(${event.id},'${safeTitle}')"><i class="fas fa-trash-alt"></i>Delete Booking</button>`;

        const actionsCard = `<div class="bdoc-actions">${actionsHtml}</div>`;

        // ── Assemble & open offcanvas ─────────────────────────────
        document.getElementById('bdoc_Content').innerHTML = infoCard + paymentSummaryCard + paymentManageCard + actionsCard;

        // Initialize live summary with current values
        _bdocSummary(event.id, totalPrice);

        const oc = new bootstrap.Offcanvas(document.getElementById('bookingDetailOffcanvas'), { backdrop: true, scroll: false });
        oc.show();
    }

    // Live payment summary updater (called by oninput)
    function _bdocSummary(id, totalPrice) {
        const adv  = parseFloat(document.getElementById(`advAmt_${id}`)?.value  || 0) || 0;
        const fin  = parseFloat(document.getElementById(`finalAmt_${id}`)?.value || 0) || 0;
        const paid = adv + fin;
        const bal  = Math.max(0, totalPrice - paid);

        const paidEl   = document.getElementById(`paySummaryPaid_${id}`);
        const balEl    = document.getElementById(`paySummaryBal_${id}`);
        const statusEl = document.getElementById(`paySummaryStatus_${id}`);

        if (paidEl)   paidEl.textContent = `₹${paid.toLocaleString('en-IN')}`;
        if (balEl) {
            balEl.textContent = `₹${bal.toLocaleString('en-IN')}`;
            balEl.style.color = bal === 0 ? '#198754' : '#dc3545';
        }
        if (statusEl) {
            if (bal === 0)     { statusEl.textContent = '✓ Fully paid';  statusEl.style.color = '#198754'; }
            else if (paid > 0) { statusEl.textContent = `Partial — ₹${bal.toLocaleString('en-IN')} remaining`; statusEl.style.color = '#f59e0b'; }
            else               { statusEl.textContent = ''; }
        }
    }

    // Frontend PDF generation: fetch invoice HTML from backend and render to a single-page A4 PDF.
    // We render the server HTML inside an <iframe> (NOT a <div>) because the response is a full
    // HTML document including <style> rules in <head>. Setting innerHTML on a <div> would strip
    // <html>/<head>/<body> wrappers and the styles inside them, leaving the .a4-page unstyled and
    // causing html2canvas to capture an empty/broken canvas.
    function downloadInvoice(bookingId) {
        return fetch(`/Scheduler/GetInvoiceHtml?bookingId=${bookingId}`)
            .then(res => {
                if (!res.ok) throw new Error('Failed to load invoice HTML (HTTP ' + res.status + ')');
                return res.text();
            })
            .then(html => new Promise((resolve, reject) => {
                const iframe = document.createElement('iframe');
                iframe.style.position = 'fixed';
                iframe.style.left = '-10000px';
                iframe.style.top = '0';
                iframe.style.width = '794px';
                iframe.style.height = '1123px';
                iframe.style.border = '0';
                iframe.setAttribute('aria-hidden', 'true');

                const cleanup = () => { if (iframe.parentNode) iframe.parentNode.removeChild(iframe); };

                iframe.onload = function () {
                    try {
                        const doc = iframe.contentDocument || iframe.contentWindow.document;
                        const element = doc.querySelector('.a4-page') || doc.body;

                        const render = () => {
                            html2canvas(element, {
                                scale: 2,
                                useCORS: true,
                                backgroundColor: '#ffffff',
                                windowWidth: 794
                            })
                            .then(canvas => {
                                const { jsPDF } = window.jspdf;
                                const pageW = 794;
                                const pageH = 1123;
                                const pdf = new jsPDF({ unit: 'px', format: [pageW, pageH], orientation: 'portrait', hotfixes: ['px_scaling'] });
                                const imgData = canvas.toDataURL('image/png');

                                // Preserve aspect ratio: scale image to fit page width, keep natural height
                                const imgW = pageW;
                                const imgH = (canvas.height * imgW) / canvas.width;
                                const finalW = imgH <= pageH ? imgW : (canvas.width * pageH) / canvas.height;
                                const finalH = imgH <= pageH ? imgH : pageH;
                                const offsetX = (pageW - finalW) / 2;
                                const offsetY = 0;
                                pdf.addImage(imgData, 'PNG', offsetX, offsetY, finalW, finalH);
                                pdf.save(`Invoice_${bookingId}.pdf`);
                                cleanup();
                                resolve();
                            })
                            .catch(err => { cleanup(); reject(err); });
                        };

                        // Wait for any web fonts inside the iframe to be ready before rasterizing
                        if (doc.fonts && doc.fonts.ready && typeof doc.fonts.ready.then === 'function') {
                            doc.fonts.ready.then(render).catch(render);
                        } else {
                            render();
                        }
                    } catch (err) {
                        cleanup();
                        reject(err);
                    }
                };

                iframe.onerror = function (err) {
                    cleanup();
                    reject(err || new Error('Iframe failed to load invoice HTML'));
                };

                document.body.appendChild(iframe);

                // Use srcdoc when supported (preserves the full document including <style> tags),
                // fall back to document.write for older browsers.
                if ('srcdoc' in iframe) {
                    iframe.srcdoc = html;
                } else {
                    const doc = iframe.contentDocument || iframe.contentWindow.document;
                    doc.open();
                    doc.write(html);
                    doc.close();
                }
            }));
    }

    function completeBookingWithInvoice(bookingId, bookingTitle) {
        const checkbox = document.getElementById(`paymentPaidCheck_${bookingId}`);
        if (!checkbox.checked) {
            showNotification('Check the checkbox to confirm.', 'error');
            return;
        }

        if (!confirm(`Generate invoice for: ${bookingTitle}?`)) return;

        showLoading('Marking as paid...');

        // 1) Mark the booking as paid on the server.
        // 2) Once that succeeds, actually generate the invoice PDF on the client
        //    (downloadInvoice returns a promise — we MUST await it so the spinner
        //    stays open until the PDF is built, otherwise the download silently
        //    fails for the user).
        $.ajax({
            url: '/Scheduler/CompleteBookingWithInvoice',
            type: 'POST',
            data: { bookingId }
        })
        .done(function (response) {
            if (!response || !response.success) {
                hideLoading();
                showNotification((response && response.message) || 'Failed to mark booking as paid.', 'error');
                return;
            }

            showLoading('Generating invoice...');
            downloadInvoice(bookingId)
                .then(() => {
                    showNotification('Invoice generated successfully!', 'success');
                    // Refresh the calendar so the new "Paid" status is reflected.
                    if (typeof refreshCalendarData === 'function') {
                        refreshCalendarData();
                    }
                })
                .catch(err => {
                    console.error('Invoice download failed:', err);
                    showNotification('Invoice download failed. Please try again.', 'error');
                })
                .finally(hideLoading);
        })
        .fail(function () {
            hideLoading();
            showNotification('Error marking booking as paid.', 'error');
        });
    }

    function generateBookingInvoice(bookingId, bookingTitle) {
        if (!confirm(`Generate invoice for: ${bookingTitle}?`)) return;

        showLoading('Generating invoice...');
        downloadInvoice(bookingId)
            .then(() => showNotification('Invoice generated successfully!', 'success'))
            .finally(hideLoading);
    }

    function deleteBooking(bookingId, bookingTitle) {
        if (!confirm(`Delete: ${bookingTitle}?`)) return;

        showLoading('Deleting...');

        $.ajax({
            url: '/Scheduler/DeleteBooking',
            type: 'POST',
            data: { bookingId },
            success: function (response) {
                if (response.success) {
                    showNotification('Deleted!', 'success');
                    setTimeout(() => $('.notification').remove(), 2000);
                    setTimeout(() => loadInitialBookings(), 1000);
                } else {
                    showNotification(response.message || 'Failed.', 'error');
                }
            },
            complete: hideLoading
        });
    }

    function savePaymentDetails(bookingId, bookingTitle, totalPrice) {
        const advAmt    = parseFloat(document.getElementById(`advAmt_${bookingId}`)?.value   || 0) || 0;
        const advMethod = document.getElementById(`advMethod_${bookingId}`)?.value  || '';
        const finAmt    = parseFloat(document.getElementById(`finalAmt_${bookingId}`)?.value  || 0) || 0;
        const finMethod = document.getElementById(`finalMethod_${bookingId}`)?.value || '';

        // Validate: need at least advance amount + method  OR  final amount + method
        if (advAmt <= 0 && finAmt <= 0) {
            showNotification('Please enter at least one payment amount.', 'error');
            return;
        }
        if (advAmt > 0 && !advMethod) {
            showNotification('Please select a payment method for the advance/full payment.', 'error');
            return;
        }
        if (finAmt > 0 && !finMethod) {
            showNotification('Please select a payment method for the final/remaining payment.', 'error');
            return;
        }

        const totalPaid = advAmt + finAmt;
        const willBePaid = totalPaid >= totalPrice;
        const confirmMsg = willBePaid
            ? `Save payment and mark "${bookingTitle}" as fully Paid?`
            : `Save advance payment of ₹${advAmt.toLocaleString('en-IN')} for "${bookingTitle}"?\nRemaining ₹${(totalPrice - totalPaid).toLocaleString('en-IN')} will be recorded as pending.`;

        if (!confirm(confirmMsg)) return;

        showLoading('Saving payment...');
        $.ajax({
            url: '/Scheduler/SavePaymentDetails',
            type: 'POST',
            data: {
                bookingId,
                advanceAmount: advAmt,
                advancePaymentMethod: advMethod,
                finalAmount: finAmt > 0 ? finAmt : null,
                finalPaymentMethod: finAmt > 0 ? finMethod : null
            },
            success: function (response) {
                if (response.success) {
                    showNotification(response.message || 'Payment saved!', 'success');
                    setTimeout(() => {
                        $('.notification').remove();
                        if (typeof refreshCalendarData === 'function') refreshCalendarData();
                    }, 1500);
                } else {
                    showNotification(response.message || 'Failed to save payment.', 'error');
                }
            },
            error: function () { showNotification('Error saving payment details.', 'error'); },
            complete: hideLoading
        });
    }

    // Called by oninput on amount fields — dynamically updates the live summary
    // We use a factory approach because bookingId is dynamic at render time.
    function _makePaymentSummaryUpdater(bookingId, totalPrice) {
        return function () {
            const advAmt = parseFloat(document.getElementById(`advAmt_${bookingId}`)?.value  || 0) || 0;
            const finAmt = parseFloat(document.getElementById(`finalAmt_${bookingId}`)?.value || 0) || 0;
            const paid   = advAmt + finAmt;
            const bal    = Math.max(0, totalPrice - paid);

            const paidEl   = document.getElementById(`paySummaryPaid_${bookingId}`);
            const balEl    = document.getElementById(`paySummaryBal_${bookingId}`);
            const statusEl = document.getElementById(`paySummaryStatus_${bookingId}`);

            if (paidEl)   paidEl.textContent   = `₹${paid.toLocaleString('en-IN')}`;
            if (balEl) {
                balEl.textContent = `₹${bal.toLocaleString('en-IN')}`;
                balEl.style.color = bal === 0 ? '#198754' : '#dc3545';
            }
            if (statusEl) {
                if (bal === 0)        { statusEl.textContent = '✓ Fully paid'; statusEl.style.color = '#198754'; }
                else if (paid > 0)    { statusEl.textContent = `Partial — ₹${bal.toLocaleString('en-IN')} remaining`; statusEl.style.color = '#fd7e14'; }
                else                  { statusEl.textContent = ''; }
            }
        };
    }

    // Dynamically register the updater after each popup render (delegated event)
    $(document).on('input', '[id^="advAmt_"],[id^="finalAmt_"]', function () {
        const id    = this.id.replace('advAmt_', '').replace('finalAmt_', '');
        const total = parseFloat(this.closest('[data-booking-price]')?.dataset?.bookingPrice || 0);
        // Try to read total from advAmt max attribute as fallback
        const maxAttr = document.getElementById(`advAmt_${id}`)?.getAttribute('max');
        const price   = total || parseFloat(maxAttr || 0) || 0;
        _makePaymentSummaryUpdater(id, price)();
    });

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/signalR")
        .build();

    connection.on("BindBookingFromAirbnb", function (Bookings) {
        try {
            allBookingsData = Bookings;
            Object.values(calendars).forEach(cal => cal && cal.removeAllEvents());
            loadInitialBookings();
        } catch (error) {
            console.error('SignalR error:', error);
        }
    });

    connection.start().catch(err => console.error(err.toString()));

    // ---- Pending Booking Requests ----
    let currentConfirmBookingId = null;

    function openPendingRequestsModal() {
        const modal = new bootstrap.Modal(document.getElementById('pendingRequestsModal'));
        modal.show();
        loadPendingRequests();
    }

    function loadPendingRequests() {
        document.getElementById('pendingRequestsContent').innerHTML = `
            <div class="text-center p-4">
                <div class="spinner-border text-warning" role="status"></div>
                <p class="mt-2">Loading pending requests...</p>
            </div>`;

        $.ajax({
            url: '/Scheduler/GetPendingBookingRequests',
            type: 'GET',
            success: function (data) {
                renderPendingRequests(data);
                const badge = document.getElementById('pendingRequestsBadge');
                if (data && data.length > 0) {
                    badge.textContent = data.length;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            },
            error: function () {
                document.getElementById('pendingRequestsContent').innerHTML =
                    '<div class="alert alert-danger m-3">Failed to load pending requests.</div>';
            }
        });
    }

    // Safe store for pending booking data — avoids embedding JSON in onclick attributes
    const pendingBookingStore = {};

    function renderPendingRequests(requests) {
        const container = document.getElementById('pendingRequestsContent');
        if (!requests || requests.length === 0) {
            container.innerHTML = '<div class="text-center p-4 text-muted"><i class="fas fa-check-circle fa-3x mb-3 text-success"></i><p>No pending booking requests.</p></div>';
            return;
        }

        // Store data by ID so onclick only passes the ID (avoids JSON-in-attribute issues)
        requests.forEach(function (b) { pendingBookingStore[b.id] = b; });

        let html = '<div class="table-responsive"><table class="table table-hover booking-requests-table mb-0">';
        html += `<thead class="table-light"><tr>
            <th>Guest</th><th>Contact</th><th>Property</th><th>Dates</th>
            <th>Guests</th><th>Purpose</th><th>Requested Payment</th><th>Price</th><th>Submitted</th><th>Action</th>
        </tr></thead><tbody>`;

        requests.forEach(function (b) {
            const guestBreakdown = [
                b.totalAdults ? `Adults: ${b.totalAdults}` : '',
                b.totalKids   ? `Kids: ${b.totalKids}`   : '',
                b.maleCount   ? `M: ${b.maleCount}`      : '',
                b.femaleCount ? `F: ${b.femaleCount}`    : ''
            ].filter(Boolean).join(', ');

            const purposeDisplay = (b.purposeOfVisit === 'Other' && b.purposeOfVisitOther)
                ? b.purposeOfVisitOther : (b.purposeOfVisit || '—');

            const businessInfo = b.businessName
                ? `<br><small class="text-muted">${b.businessName}${b.gstNumber ? ' · GST: ' + b.gstNumber : ''}</small>`
                : '';

            const propertyName = b.homeId === 1 ? 'Ground Floor Classic'
                               : b.homeId === 2 ? '1st Floor Heritage'
                               : 'Property ' + b.homeId;

            const submittedDate = b.createdAt
                ? new Date(b.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' })
                : '—';

            html += `<tr>
                <td><strong>${b.customerName || '—'}</strong>${businessInfo}</td>
                <td><small>${b.customerEmail || ''}<br>${b.customerPhone || ''}</small></td>
                <td><small>${propertyName}</small></td>
                <td><small>${b.bookingDateFrom}<br>to ${b.bookingDateTo}</small></td>
                <td>${b.guestNumbers || '—'}${guestBreakdown ? '<br><small class="text-muted">' + guestBreakdown + '</small>' : ''}</td>
                <td><small>${purposeDisplay}</small></td>
                <td><span class="badge bg-secondary">${b.paymentMethod || b.paymentStatus || '—'}</span></td>
                <td><strong>₹${(b.price || 0).toLocaleString('en-IN')}</strong></td>
                <td><small>${submittedDate}</small></td>
                <td>
                    <button class="btn btn-success btn-sm w-100 approve-btn"
                            onclick="openConfirmBookingModal(${b.id})">
                        <i class="fas fa-check me-1"></i>Approve
                    </button>
                </td>
            </tr>`;
        });

        html += '</tbody></table></div>';
        container.innerHTML = html;
    }

    function openConfirmBookingModal(bookingId) {
        const b = pendingBookingStore[bookingId];
        if (!b) { showToast('Booking data not found. Please refresh.', 'error'); return; }

        currentConfirmBookingId = bookingId;

        // Summary banner
        const advanceSuggestion = Math.round((b.price || 0) / 2);
        document.getElementById('confirmBookingInfo').innerHTML = `
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <span><i class="fas fa-user me-1"></i><strong>${b.customerName || '—'}</strong></span>
                <span><i class="fas fa-calendar me-1"></i>${b.bookingDateFrom} → ${b.bookingDateTo}</span>
                <span><i class="fas fa-users me-1"></i>Guests: ${b.guestNumbers || '—'}</span>
                <span class="ms-auto"><i class="fas fa-rupee-sign me-1"></i><strong>Total: ₹${(b.price || 0).toLocaleString('en-IN')}</strong></span>
            </div>`;

        // Pre-fill fields
        document.getElementById('cbp_AmountPaid').value        = advanceSuggestion;   // suggest 50%
        document.getElementById('cbp_FinalRoomPrice').value    = '';
        document.getElementById('cbp_Notes').value             = '';
        document.getElementById('cbp_PaymentStatus').value     = 'Partial';            // default: advance
        document.getElementById('cbp_AdvanceSuggestion').textContent =
            `Suggested 50% advance: ₹${advanceSuggestion.toLocaleString('en-IN')} · Full: ₹${(b.price || 0).toLocaleString('en-IN')}`;

        // Pre-set payment method if it matches a known option
        const methodSel = document.getElementById('cbp_PaymentMethod');
        const knownMethods = ['Cash', 'UPI', 'Card', 'Bank Transfer', 'Online'];
        methodSel.value = (b.paymentMethod && knownMethods.includes(b.paymentMethod)) ? b.paymentMethod : '';

        // Clear any previous inline errors
        document.getElementById('cbp_MethodError').style.display = 'none';
        document.getElementById('cbp_ModalError').style.display  = 'none';

        // Transition: hide pending list → show confirm modal
        const pendingModal = bootstrap.Modal.getInstance(document.getElementById('pendingRequestsModal'));
        if (pendingModal) {
            pendingModal.hide();
            document.getElementById('pendingRequestsModal').addEventListener('hidden.bs.modal', function openConfirm() {
                document.getElementById('pendingRequestsModal').removeEventListener('hidden.bs.modal', openConfirm);
                new bootstrap.Modal(document.getElementById('confirmBookingPaymentModal')).show();
            }, { once: true });
        } else {
            new bootstrap.Modal(document.getElementById('confirmBookingPaymentModal')).show();
        }
    }

    function submitConfirmBookingPayment() {
        if (!currentConfirmBookingId) return;

        const paymentMethod = document.getElementById('cbp_PaymentMethod').value;
        const errEl = document.getElementById('cbp_MethodError');
        if (!paymentMethod) {
            errEl.textContent = 'Please select a payment method.';
            errEl.style.display = 'block';
            document.getElementById('cbp_PaymentMethod').focus();
            return;
        }
        errEl.style.display = 'none';

        const amountPaid     = parseFloat(document.getElementById('cbp_AmountPaid').value)     || 0;
        const finalRoomPrice = parseFloat(document.getElementById('cbp_FinalRoomPrice').value) || null;
        const paymentStatus  = document.getElementById('cbp_PaymentStatus').value;
        const notes          = document.getElementById('cbp_Notes').value.trim();

        const payload = {
            BookingId:       currentConfirmBookingId,
            PaymentMethod:   paymentMethod,
            AmountPaid:      amountPaid,
            FinalRoomPrice:  finalRoomPrice,
            IsAdvancePayment: paymentStatus === 'Partial',
            Notes:           notes
        };

        const btn = document.getElementById('cbp_ConfirmBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Confirming...';

        $.ajax({
            url: '/Scheduler/ConfirmBookingWithPayment',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (result) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check me-1"></i>Approve Booking';
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmBookingPaymentModal'))?.hide();
                    showToast('Booking approved and payment recorded!', 'success');
                    loadInitialBookings();
                    // Remove from store and refresh pending count
                    delete pendingBookingStore[currentConfirmBookingId];
                    currentConfirmBookingId = null;
                    $.ajax({
                        url: '/Scheduler/GetPendingBookingRequests', type: 'GET',
                        success: function (data) {
                            const badge = document.getElementById('pendingRequestsBadge');
                            if (data && data.length > 0) { badge.textContent = data.length; badge.classList.remove('d-none'); }
                            else { badge.classList.add('d-none'); }
                        }
                    });
                } else {
                    document.getElementById('cbp_ModalError').textContent = result.message || 'Failed to confirm booking.';
                    document.getElementById('cbp_ModalError').style.display = 'block';
                }
            },
            error: function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check me-1"></i>Approve Booking';
                document.getElementById('cbp_ModalError').textContent = 'A server error occurred. Please try again.';
                document.getElementById('cbp_ModalError').style.display = 'block';
            }
        });
    }

    function showToast(message, type) {
        const bg = type === 'success' ? '#198754' : '#dc3545';
        const toast = document.createElement('div');
        toast.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;background:${bg};color:white;padding:12px 20px;border-radius:8px;font-weight:600;box-shadow:0 4px 15px rgba(0,0,0,0.3);transition:opacity 0.5s;`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 500); }, 3000);
    }

    // Load pending count on page load
    $(document).ready(function () {
        $.ajax({
            url: '/Scheduler/GetPendingBookingRequests',
            type: 'GET',
            success: function (data) {
                const badge = document.getElementById('pendingRequestsBadge');
                if (data && data.length > 0) {
                    badge.textContent = data.length;
                    badge.classList.remove('d-none');
                }
            }
        });
    });
</script>