@model List<Home>

@{
    ViewData["Title"] = "Home Master";
}

<h2>Home Master</h2>

<a href="/YourController/AddHome" class="btn btn-success mb-2">+ Add Home</a>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Description</th>
            <th>Price Per Day</th>
            <th>Created At</th>
            <th>Submitted User</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var home in Model)
        {
            <tr>
                <td>@home.Name</td>
                <td>@home.Location</td>
                <td>@home.Description</td>
                <td>@home.PricePerDay?.ToString("C")</td>
                <td>@home.CreatedAt?.ToString("dd-MM-yyyy")</td>
                <td>@home.SUser</td>
                <td>
                    <a href="/YourController/EditHome/@home.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a href="/YourController/DeleteHome/@home.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
