<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Assignment6</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assignment6.styles.css" asp-append-version="true" />
    <link href="~/css/common.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- FullCalendar CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <!-- Litepicker JS -->
    <script src="https://cdn.jsdelivr.net/npm/litepicker/dist/bundle.js"></script>
    <!-- Litepicker CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/litepicker/dist/css/litepicker.css" rel="stylesheet" />
   
    <script src="~/js/common.js"></script>
    <link href="~/toastr/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/toastr/sweetalert2.min.js"></script>

    <style>
        /* Simple Notification Bell Styles */
        .notification-bell {
            background: transparent;
            border: none;
            color: #333;
            font-size: 1.2rem;
            padding: 8px;
            cursor: pointer;
            position: relative;
        }

        .notification-bell:hover {
            color: #007bff;
        }

        .notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .notification-badge.d-none {
            display: none !important;
        }

        /* Simple responsive layout */
        @@media (max-width: 767px) {
            .navbar-brand {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">
                <!-- Brand -->
                <a class="navbar-brand" asp-area="" asp-controller="Website" asp-action="Website" onclick="SetLoginMode()">Assignment6</a>
                
                <!-- Bell and Toggler (right side) -->
                <div class="d-flex align-items-center">
                    <!-- Notification Bell -->
                    <button id="notification-bell" class="notification-bell me-2" onclick="showBookingRequests()" title="Booking Requests">
                        <i class="fas fa-bell"></i>
                        <span id="notification-badge" class="notification-badge d-none">0</span>
                    </button>
                    
                    <!-- Menu Toggle Button -->
                    <button class="navbar-toggler" type="button" onclick="toggleMenu()">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Collapsible Menu -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Scheduler" asp-action="Scheduler">Scheduler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Configuration" asp-action="GetMaster">Master</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Configuration" asp-action="Configuration" target="_blank">Create Layout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container-fluid">
        <main role="main" style="padding-bottom: 85px;">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Assignment6 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @if (ViewData["Title"] == "Login" && ViewData["Title"] == "Website")
    {
        <script>
            debugger
            if (localStorage.getItem('IsLoggedIn') == "true") {
                window.location.href = "/Login/Login";
            }
            else {
                window.location.href = "/Website/Website";
            }
        </script>
    }
   
 
    <script>
        // Simple toggle function
        function SetLoginMode() {
            localStorage.setItem('IsLoggedIn', false);
        }

        function toggleMenu() {
            const navbarNav = document.getElementById('navbarNav');
            const isOpen = navbarNav.classList.contains('show');
            
            if (isOpen) {
                // Close menu
                navbarNav.classList.remove('show');
            } else {
                // Open menu
                navbarNav.classList.add('show');
            }
        }

        // Close menu when clicking on nav links (mobile)
        document.addEventListener('DOMContentLoaded', function() {
            const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
            
            navLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    const navbarNav = document.getElementById('navbarNav');
                    navbarNav.classList.remove('show');
                });
            });

            // Close menu when clicking outside
            document.addEventListener('click', function(event) {
                const navbar = document.querySelector('.navbar');
                const navbarNav = document.getElementById('navbarNav');
                
                if (!navbar.contains(event.target) && navbarNav.classList.contains('show')) {
                    navbarNav.classList.remove('show');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>